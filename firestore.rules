/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and their associated data
 * (wrong answers, problem attempts). Public read access is granted to land tiles and map events
 * to facilitate gameplay and display map updates. Country and Join/Alliance requests have public read and create,
 * but updates and deletes are restricted to maintain game integrity.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, secured with owner-only access for updates.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problem attempts for a user, secured with owner-only access.
 * - /countries/{countryId}: Stores countries, with public read access.
 * - /land_tiles/{landTileId}: Stores land tiles, with public read access and open writes.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user problem attempts, secured with owner-only access.
 * - /join_requests/{requestId}: Stores requests from users to join a country.
 * - /alliance_requests/{requestId}: Stores requests from countries to form an alliance.
 * - /map_events/{eventId}: Stores map change events, with public read and create access.
 *
 * Key Security Decisions:
 * - User listing is allowed to facilitate finding other players.
 * - Land tiles are publicly readable and writable.
 * - Map events are publicly readable and writable.
 * - Write operations are restricted based on user authentication and ownership.
 *
 * Denormalization for Authorization:
 * - The `LandTile` entity's `ownerId` field is used to quickly determine ownership without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants owner-only access to user profiles.
     * @path /users/{userId}
     * @allow (get, list, create) if true
     * @allow (update) if request.auth.uid == userId
     * @deny (delete) if false
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get, list, create: if true;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Grants owner-only access to wrong answer records.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create) if isOwner(userId)
     * @allow (update, delete) if isOwner(userId) && resource != null
     * @deny If the user is not the owner.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow list, get, create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to countries, but restricts create and update operations.
     * @path /countries/{countryId}
     * @allow (list, get) if true
     * @allow (create, update) if true
     * @deny (delete) if false
     */
    match /countries/{countryId} {
      allow list, get: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    /**
     * @description Allows public read and write access to land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (list, get) if true
     * @allow (create, update, delete) if true
     * @principle Allows all authenticated users access.
     */
    match /land_tiles/{landTileId} {
      allow list, get: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Grants owner-only access to problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if isOwner(userId)
     * @deny (update, delete) if false
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow list, get, create: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }
    /**
     * @description Allows anyone to create join requests; allows read, update, and delete operations.
     * @path /join_requests/{requestId}
     * @allow list, get, create: if true
     * @allow update, delete: if true
     */
    match /join_requests/{requestId} {
        allow list, get, create: if true;
        allow update, delete: if true;
    }

    /**
     * @description Allows anyone to create alliance requests; allows read, update, and delete operations.
     * @path /alliance_requests/{requestId}
     * @allow list, get, create: if true
     * @allow update, delete: if true
     */
    match /alliance_requests/{requestId} {
        allow list, get, create: if true;
        allow update, delete: if true;
    }

    /**
     * @description Allows public read and create access to map events.
     * @path /map_events/{eventId}
     * @allow (list, create) if true
     * @deny (get, update, delete) if false
     */
    match /map_events/{eventId} {
        allow list, create: if true;
        allow get, update, delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}