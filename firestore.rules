/**
 * @file Firestore Security Rules for Decimal Conquest
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on ownership and role-based access control.
 * It enforces a strict ownership model for user-specific data and allows for public read access where appropriate.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profiles, accessible only to the owning user.
 * - `/users/{userId}/wrong_answers/{wrongAnswerId}`: Stores incorrect problems for a user, accessible only to the owning user.
 * - `/countries/{countryId}`: Stores countries, with open read access and owner-based write access.
 * - `/land_tiles/{landTileId}`: Stores land tiles on the game map. Allows any signed-in user to read and create tiles, but update and delete are restricted to the owner.
 * - `/problem_attempts/{userId}/attempts/{attemptId}`: Stores user problem attempts, accessible only to the owning user.
 * - `/join_requests/{requestId}`: Stores requests from users to join a country.  Anyone can create, but update is limited.
 * - `/alliance_requests/{requestId}`: Stores requests from countries to form an alliance. Anyone can create, but update is limited.
 *
 * Key Security Decisions:
 * - Users can only access their own user documents and associated subcollections.
 * - Public read access is granted to the `/countries` and `/land_tiles` collections.
 * - The `list` operation is generally allowed for user-scoped subcollections, enabling clients to list their own data.
 * - The rules enforce relational integrity by validating the `ownerId` on `create` operations to match the authenticated user's ID.
 * - Document existence is verified before all `update` and `delete` operations to prevent errors.
 *
 * Denormalization for Authorization:
 * - The `LandTile` entity includes an `ownerId` field to enable efficient owner-based access control without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User 'lhUvcngwbYR2jDgn7EZyqTcvMb93' can create their own profile with matching ID.
     * @allow (get, list, update) - User 'lhUvcngwbYR2jDgn7EZyqTcvMb93' can read/update their own profile.
     * @deny (create) - User 'attackerId' cannot create a profile with ID 'lhUvcngwbYR2jDgn7EZyqTcvMb93'.
     * @deny (get, list, update) - User 'attackerId' cannot read/update profile 'lhUvcngwbYR2jDgn7EZyqTcvMb93'.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Stores incorrect problems for a user. Only the user can manage their own wrong answers.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) - User 'lhUvcngwbYR2jDgn7EZyqTcvMb93' can create a wrong answer under their profile.
     * @allow (get, list, update, delete) - User 'lhUvcngwbYR2jDgn7EZyqTcvMb93' can manage wrong answers under their profile.
     * @deny (create) - User 'attackerId' cannot create wrong answers under user 'lhUvcngwbYR2jDgn7EZyqTcvMb93' profile.
     * @deny (get, list, update, delete) - User 'attackerId' cannot manage wrong answers under user 'lhUvcngwbYR2jDgn7EZyqTcvMb93' profile.
     * @principle Enforces user-ownership for personal problem data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores country data. Allows open reads and owner-based writes.
     * @path /countries/{countryId}
     * @allow (get, list) - Any user can read the list of countries or a specific country.
     * @allow (create) - Any signed-in user can create a country.
     * @allow (update) - Only the creator of the country can update it.
     * @deny (create) - Unauthenticated user cannot create.
     * @deny (update) - User who is not the creator cannot update.
     * @principle Allows public reads, restricts writes to country creators.
     */
    match /countries/{countryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if resource.data.createdBy == request.auth.uid && resource != null;
      allow delete: if false;
    }

    /**
     * @description Stores land tiles on the game map. Accessible to all authenticated users for gameplay.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any signed-in user can read land tiles.
     * @allow (create) - Any signed-in user can create a land tile, as long as they are the owner.
     * @allow (update) - Only the owner of the land tile can update it.
     * @deny (update) - User who is not the owner cannot update.
     * @principle Public read access, owner-based write access.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId)  && resource != null;
      allow delete: if false;
    }

    /**
     * @description Stores user problem attempts. Only the user can access their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) - User 'lhUvcngwbYR2jDgn7EZyqTcvMb93' can read/write attempts under their profile.
     * @deny (get, list, create) - User 'attackerId' cannot read/write attempts under user 'lhUvcngwbYR2jDgn7EZyqTcvMb93' profile.
     * @principle Enforces user-ownership for personal problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores requests from users to join a country.
     * @path /join_requests/{requestId}
     * @allow (get, list, create) - Any signed-in user can create or read join requests.
     * @allow (update) - Only specific user roles can update the join requests.
     */
    match /join_requests/{requestId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Stores requests from countries to form an alliance.
     * @path /alliance_requests/{requestId}
     * @allow (get, list, create) - Any signed-in user can create or read alliance requests.
     * @allow (update) - Only specific user roles can update the alliance requests.
     */
    match /alliance_requests/{requestId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}