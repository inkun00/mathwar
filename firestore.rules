/**
 * @fileoverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansions,
 * and public read access for countries, land tiles, and problems.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /countries/{countryId}: Stores countries, accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Stores land tiles, publicly readable.
 * - /problems/{problemId}: Stores math problems, publicly readable.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansion events for each user,
 *   accessible only to the user themselves.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data and territory expansion records.
 * - Countries, land tiles, and problems are publicly readable.
 * - User listing is disallowed.
 * - Denormalization of `ownerId` in `land_tiles` enables efficient ownership checks without extra reads.
 * - The `createdBy` field in `countries` allows tracking country creators, but doesn't restrict read access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Controls access to country data.
     * @path /countries/{countryId}
     * @allow (get) Any authenticated user can read country data.
     * @allow (list) Any authenticated user can list countries.
     * @deny (create) An unauthenticated user cannot create a country.
     * @deny (update) An unauthenticated user cannot update a country.
     * @deny (delete) An unauthenticated user cannot delete a country.
     * @principle Allows public read access to countries.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any user can read land tile data.
     * @allow (list) Any user can list land tiles.
     * @deny (create) No one can create land tiles through client-side rules.
     * @deny (update) No one can update land tiles through client-side rules.
     * @deny (delete) No one can delete land tiles through client-side rules.
     * @principle Allows public read access to land tiles.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to problem data.
     * @path /problems/{problemId}
     * @allow (get) Any user can read problem data.
     * @allow (list) Any user can list problems.
     * @deny (create) No one can create problems through client-side rules.
     * @deny (update) No one can update problems through client-side rules.
     * @deny (delete) No one can delete problems through client-side rules.
     * @principle Allows public read access to problems.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to territory expansion data for a specific user.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) User with ID 'user123' can create their own territory expansion record.
     * @allow (get) User with ID 'user123' can read their own territory expansion record.
     * @allow (list) User with ID 'user123' can list their own territory expansion records.
     * @allow (update) User with ID 'user123' can update their own territory expansion record.
     * @allow (delete) User with ID 'user123' can delete their own territory expansion record.
     * @deny (create) User with ID 'user456' cannot create a territory expansion record for user 'user123'.
     * @principle Enforces document ownership for all operations on territory expansion records.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userId == userId && resource != null;
    }
  }
}