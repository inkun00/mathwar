/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with ownership-based access control.
 * Users have full control over their own data and limited access to shared game data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible and modifiable only by the user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores user-specific incorrect math problems.
 * - /countries/{countryId}: Stores country data, created by users and readable by all authenticated users.
 * - /land_tiles/{landTileId}: Stores game board tile data, readable and writable by all authenticated users.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores attempts to decimal problems.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user documents and related subcollections.
 * - Game data (countries, land tiles) is publicly readable, but write access is restricted to authenticated users with owner validation.
 *
 * Denormalization for Authorization:
 *  - The rules rely on the `ownerId` or `createdBy` fields within documents to enforce ownership.  This avoids costly `get()` operations.
 *
 * Structural Segregation:
 *  - User-specific data (profile, wrong answers) is stored in private subcollections under the `/users/{userId}` path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if isOwner(userId)
     * @allow (update) if isExistingOwner(userId)
     * @deny (delete) always
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; //Enforce immutable id
      allow delete: if false;
    }

    /**
     * @description Controls access to user-specific wrong answers.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get, list) if isOwner(userId)
     * @allow (create) if isOwner(userId)
     * @allow (update) if isExistingOwner(userId)
     * @allow (delete) if isExistingOwner(userId)
     * @deny If not the owner.
     * @principle Restricts access to a user's own wrong answers.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to countries.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @allow (update) if isExistingOwner(resource.data.createdBy)
     * @deny (delete) always
     * @principle Allows public read access to countries, but restricts writes to authenticated users with owner validation.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingOwner(resource.data.createdBy);
      allow delete: if false;
    }

    /**
     * @description Controls access to land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @allow (update) if isExistingOwner(resource.data.ownerId)
     * @deny (delete) always
     * @principle Allows public read access to land tiles, but restricts writes to authenticated users with owner validation.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // open create during prototyping.
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list) if isOwner(userId)
     * @allow (create) if isOwner(userId)
     * @deny (update, delete) always
     * @principle Restricts access to a user's own problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update, delete: if false;
    }

    /**
     * @description Controls access to map aggregates.
     * @path /map_aggregates
     * @allow list: if false; // DENY ALL
     * @allow get, create, update, delete: if false;
     * @principle Restricts access to map aggregates.
     */
    match /map_aggregates {
      allow list: if false; // Deny list access.
      allow get, create, update, delete: if false;
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}