rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Allow anyone to read the list of users (for leaderboards, etc.)
      allow list: if true;
      // Allow logged-in users to read individual user profiles
      allow get: if request.auth != null;
      // Allow a user to create their own user document
      allow create: if request.auth.uid == userId;
      // Allow a user to update their own document, or update specific fields for game logic
      allow update: if request.auth.uid == userId || 
                       (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'conqueredCountries']));
    }

    // Countries collection
    match /countries/{countryId} {
      // Allow anyone to read countries list (for signup)
      allow read: if true;
      // Allow logged-in users to create new countries
      allow create: if request.auth != null;
      // Allow logged-in users to update the 'demised' status of a country
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['demised']);
    }

    // Land tiles collection
    match /land_tiles/{landTileId} {
      // Allow anyone to read the map state
      allow read: if true;
      // Allow logged-in users to create or update tiles (conquer)
      allow write: if request.auth != null;
    }

    // Problem Attempts subcollection
    match /problem_attempts/{userId}/{documents=**} {
       // A user can read and write to their own attempts subcollection
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Wrong Answers subcollection
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      // A user can manage their own wrong answers list
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
