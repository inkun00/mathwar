/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model where
 * users can only read and write their own data. Public read access is granted
 * to certain collections while still restricting writes to authorized users.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores wrong answers for a user.
 * - /countries/{countryId}: Stores country data.
 * - /land_tiles/{landTileId}: Stores land tile data.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's problem attempts.
 *
 * Key Security Decisions:
 * - Users can only manage their own user documents and associated wrong answer data.
 * - Public read access is enabled for the 'countries' and 'land_tiles' collections.
 * - 'problem_attempts' are only accessible to the user who created them.
 *
 * Denormalization for Authorization:
 *   - Countries: The `createdBy` field on the country document is used to
 *     enforce ownership for updates and deletes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and update their own profile data.
     * @path /users/{userId}
     * @allow (get, update) User with matching {userId} can read and update.
     * @deny (get, update) User with non-matching {userId} cannot read or update.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages wrong answer data for a specific user, ensuring only the owner can access.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) User with matching {userId} can create wrong answers.
     * @allow (get, list, update, delete) User with matching {userId} can read, list, update, and delete their wrong answers.
     * @deny (create, get, list, update, delete) User with non-matching {userId} cannot manage these wrong answers.
     * @principle Enforces strict user ownership for managing personal wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows any authenticated user to read countries, but only the creator can modify them.
     * @path /countries/{countryId}
     * @allow (get, list) Any authenticated user can read countries.
     * @allow (create) Any authenticated user can create countries. The 'createdBy' field must match the user's UID.
     * @deny (create) If the 'createdBy' field does not match the user's UID.
     * @principle Public read with owner-only writes, validated by the 'createdBy' field.
     */
    match /countries/{countryId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows any authenticated user to read land tiles and allows create and update.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any authenticated user can read land tiles.
     * @allow (create) Any authenticated user can create land tiles.
     * @allow (update) Any authenticated user can update land tiles.
     * @principle Public read and write access is granted for land tiles.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    /**
     * @description Manages user's attempts at problems, ensuring only the owner can create and list.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) User with matching {userId} can create problem attempts.
     * @allow (get, list) User with matching {userId} can read and list their own problem attempts.
     * @deny (create, get, list) User with non-matching {userId} cannot manage these attempts.
     * @principle Enforces strict user ownership for managing problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}