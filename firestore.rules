/**
 * @fileoverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansions,
 * and public read access with owner-only writes for countries and land tiles.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles; only the user can modify their own profile.
 * - /countries/{countryId}: Stores country data; publicly readable, but only the creator can modify.
 * - /land_tiles/{landTileId}: Stores land tile data; publicly readable, but only the owner can modify.
 * - /problems/{problemId}: Stores math problems; publicly readable.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansion events; only the user can modify their own expansion records.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents and territory expansion records.
 * - Countries and land tiles are publicly readable, but only the owner can modify them.
 * - Problems are publicly readable.
 * - Listing all users is disallowed, but listing land tiles is allowed.
 *
 * Denormalization for Authorization:
 * - LandTile documents include the `ownerId` to allow security rules to validate ownership without needing to `get()` the user document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User 'test_user' (auth.uid: test_user) can create their own profile.
     * @allow (update) - User 'test_user' (auth.uid: test_user) can update their own profile.
     * @allow (delete) - User 'test_user' (auth.uid: test_user) can delete their own profile.
     * @deny (create) - User 'other_user' (auth.uid: other_user) cannot create a profile with ID 'test_user'.
     * @deny (update) - User 'other_user' (auth.uid: other_user) cannot update the profile of 'test_user'.
     * @deny (delete) - User 'other_user' (auth.uid: other_user) cannot delete the profile of 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages country data. Publicly readable, but only the creator can modify.
     * @path /countries/{countryId}
     * @allow (get) - Any signed-in user can read any country.
     * @allow (list) - Any signed-in user can list countries.
     * @allow (create) - User 'test_user' (auth.uid: test_user) can create a country with createdBy: 'test_user'.
     * @allow (update) - User 'test_user' (auth.uid: test_user) can update a country where resource.data.createdBy == 'test_user'.
     * @allow (delete) - User 'test_user' (auth.uid: test_user) can delete a country where resource.data.createdBy == 'test_user'.
     * @deny (create) - User 'other_user' (auth.uid: other_user) cannot create a country with createdBy: 'test_user'.
     * @deny (update) - User 'other_user' (auth.uid: other_user) cannot update a country where resource.data.createdBy == 'test_user'.
     * @deny (delete) - User 'other_user' (auth.uid: other_user) cannot delete a country where resource.data.createdBy == 'test_user'.
     * @principle Public read, owner-only writes.
     */
    match /countries/{countryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingOwner(resource.data.createdBy);
      allow delete: if isExistingOwner(resource.data.createdBy);
    }

    /**
     * @description Manages land tile data. Publicly readable, but only the owner can modify.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any signed-in user can read any land tile.
     * @allow (list) - Any signed-in user can list land tiles.
     * @allow (create) - User 'test_user' (auth.uid: test_user) can create a land tile with ownerId: 'test_user'.
     * @allow (update) - User 'test_user' (auth.uid: test_user) can update a land tile where resource.data.ownerId == 'test_user'.
     * @allow (delete) - User 'test_user' (auth.uid: test_user) can delete a land tile where resource.data.ownerId == 'test_user'.
     * @deny (create) - User 'other_user' (auth.uid: other_user) cannot create a land tile with ownerId: 'test_user'.
     * @deny (update) - User 'other_user' (auth.uid: other_user) cannot update a land tile where resource.data.ownerId == 'test_user'.
     * @deny (delete) - User 'other_user' (auth.uid: other_user) cannot delete a land tile where resource.data.ownerId == 'test_user'.
     * @principle Public read, owner-only writes.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages math problem data. Publicly readable.
     * @path /problems/{problemId}
     * @allow (get) - Any signed-in user can read any problem.
     * @allow (list) - Any signed-in user can list problems.
     * @deny (create) - No one can create problems.
     * @deny (update) - No one can update problems.
     * @deny (delete) - No one can delete problems.
     * @principle Public read, no writes.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages territory expansion data for each user. Only the user can read/write their own expansion records.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - User 'test_user' (auth.uid: test_user) can create a territory expansion record under their own user ID.
     * @allow (update) - User 'test_user' (auth.uid: test_user) can update a territory expansion record under their own user ID.
     * @allow (delete) - User 'test_user' (auth.uid: test_user) can delete a territory expansion record under their own user ID.
     * @deny (create) - User 'other_user' (auth.uid: other_user) cannot create a territory expansion record under user ID 'test_user'.
     * @deny (update) - User 'other_user' (auth.uid: other_user) cannot update a territory expansion record under user ID 'test_user'.
     * @deny (delete) - User 'other_user' (auth.uid: other_user) cannot delete a territory expansion record under user ID 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId && resource != null;
  }
}