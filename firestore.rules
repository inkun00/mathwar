/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and problem attempts,
 * while allowing public read access to countries and land tiles.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, only writable by the user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores a user's incorrect problem attempts.
 * - /countries/{countryId}: Country data, readable by all, creatable only with matching creator ID.
 * - /land_tiles/{landTileId}: Land tile data, readable and writable by any authenticated user.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's attempts at solving math problems.
 *
 * Key Security Decisions:
 * - User profiles are readable by all authenticated users but only writable by the owning user.
 * - Land tiles are readable and writable by any authenticated user for gameplay purposes.
 * - The 'attempts' subcollection is secured by path-based ownership, ensuring only the user can create attempts.
 * - Countries can be created if the 'createdBy' field matches the user's UID, enabling user-generated content.
 * - Listing of user documents is not allowed to protect user privacy.
 *
 * Denormalization for Authorization:
 * - LandTile documents should contain the `ownerId` to enable fast ownership checks without additional reads.
 *
 * Structural Segregation:
 * - User-specific data (user profiles, problem attempts) are stored under the /users/{userId} path for clear ownership and access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read any user profile.
     * @allow (create, update, delete) Authenticated user with matching UID can update their own profile.
     * @deny (create, update, delete) Authenticated user cannot modify another user's profile.
     * @principle Enforces document ownership for writes and public read for authenticated users.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer documents for a user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) Authenticated user with matching UID can manage their own wrong answers.
     * @deny (list, get, create, update, delete) Authenticated user cannot manage another user's wrong answers.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to country documents.
     * @path /countries/{countryId}
     * @allow (list, get) Any authenticated user can read country data.
     * @allow (create) Authenticated user can create a country if the creator ID matches their own.
     * @deny (create) Authenticated user cannot create a country with a mismatched creator ID.
     * @deny (update, delete) No updates or deletes allowed.
     * @principle Allows public read with owner-only create.
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (list, get, create, update) Any authenticated user can read and write land tile data.
     * @deny (delete) Deletes are not allowed.
     * @principle Allows public read and write for authenticated users.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempt documents.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) Authenticated user with matching UID can create an attempt.
     * @deny (create) Authenticated user cannot create an attempt for another user.
     * @deny (get, list, update, delete) No gets, lists, updates, or deletes allowed.
     * @principle Restricts creation to the owning user.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if false;
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return request.auth.uid == userId && resource != null;
  }
}