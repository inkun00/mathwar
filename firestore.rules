/**
 * @file Firebase Security Rules for the Decimal Conquest game.
 *
 * @description
 * Core Philosophy: This ruleset prioritizes a user-centric security model. Users have full control over their own data, while broader game data is publicly readable to facilitate gameplay.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}` and are primarily accessible to the user themselves.
 * - Game data (countries, land tiles) is stored at the top level (`/countries/{countryId}`, `/land_tiles/{landTileId}`) and is publicly readable.
 * - Problem attempts and wrong answers are stored under user subcollections for private access.
 *
 * Key Security Decisions:
 * - User listing is allowed for `/users`, but individual user data access is restricted to the user.
 * - Game data is publicly readable but write access is restricted.
 * - Data consistency is enforced for user-owned data, ensuring the path and document `id` fields match.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `userId` parameter in the path to match the authenticated user's `uid` for ownership checks. This avoids costly `get()` operations to retrieve user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (get) User with UID 'user123' can read their own profile at /users/user123.
     * @allow (list) Any signed-in user can list users to populate the game roster.
     * @allow (create) User with UID 'user123' can create their own profile at /users/user123.
     * @allow (update) User with UID 'user123' can update their own profile at /users/user123.
     * @deny (get) User with UID 'user456' cannot read the profile of user 'user123' at /users/user123.
     * @principle Enforces document ownership for writes; allows public listing of users.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer data for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get) User with UID 'user123' can read their wrong answer at /users/user123/wrong_answers/answer456.
     * @allow (list) User with UID 'user123' can list their wrong answers at /users/user123/wrong_answers.
     * @allow (create) User with UID 'user123' can create a wrong answer at /users/user123/wrong_answers/answer456.
     * @allow (update) User with UID 'user123' can update their wrong answer at /users/user123/wrong_answers/answer456.
     * @allow (delete) User with UID 'user123' can delete their wrong answer at /users/user123/wrong_answers/answer456.
     * @deny (get) User with UID 'user456' cannot read wrong answer of user 'user123' at /users/user123/wrong_answers/answer456.
     * @principle Restricts access to a user's own wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to country data.
     * @path /countries/{countryId}
     * @allow (get) Any signed-in user can read a country's data at /countries/country123.
     * @allow (list) Any signed-in user can list all countries.
     * @allow (create) Any signed-in user can create a new country at /countries/country456.
     * @allow (update) Any signed-in user can update a country's data at /countries/country456 if they created it.
     * @deny (create) User cannot create if the createdBy field does not match their UID.
     * @principle Allows public read access to country data but restricts write access to the creator.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(countryData) {
        return isSignedIn() && request.auth.uid == countryData.createdBy;
      }

      function isExistingOwner(countryData) {
        return isOwner(countryData) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingOwner(resource.data);
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any signed-in user can read a land tile's data at /land_tiles/tile123.
     * @allow (list) Any signed-in user can list all land tiles.
     * @allow (create) Any signed-in user can create a new land tile at /land_tiles/tile456.
     * @allow (update) Any signed-in user can update a land tile's data at /land_tiles/tile456.
     * @principle Allows public read access to land tile data.
     */
    match /land_tiles/{landTileId} {
        function isSignedIn() {
          return request.auth != null;
        }

        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts for a specific user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get) User with UID 'user123' can read their attempt at /problem_attempts/user123/attempts/attempt456.
     * @allow (list) User with UID 'user123' can list their attempts at /problem_attempts/user123/attempts.
     * @allow (create) User with UID 'user123' can create an attempt at /problem_attempts/user123/attempts/attempt456.
     * @deny (get) User with UID 'user456' cannot read attempt of user 'user123' at /problem_attempts/user123/attempts/attempt456.
     * @principle Restricts access to a user's own problem attempt data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}