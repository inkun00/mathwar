rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (update) if isOwner(userId)
     * @deny (create, delete) always
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Anyone who is logged in can read the user profiles
      allow get: if isSignedIn();
      allow list: if false; // Listing all users is not permitted
      // Only the user can update their own profile
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages access to a user's incorrect problem attempts.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if isOwner(userId)
     * @deny Access to other users' data.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow list, get, create, update, delete: if isOwner(userId);
    }

    /**
     * @description Controls access to countries.
     * @path /countries/{countryId}
     * @allow (list, get) if true
     * @allow (create) if isSignedIn()
     * @deny (update, delete) always
     * @principle Allows public read access with authenticated creation.
     */
    match /countries/{countryId} {
      // Anyone can read the countries
      allow list, get: if true;
      // Only signed in users can create countries
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Manages access to land tiles on the game map.
     * @path /land_tiles/{landTileId}
     * @allow (list, get, create, update) if isSignedIn()
     * @deny (delete) always
     * @principle Allows any authenticated user to modify land tiles.
     */
    match /land_tiles/{landTileId} {
      // Anyone can read the land tiles
      allow list, get: if true;
      // Only signed in users can create and update land tiles
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Stores each attempt a user makes on a problem for analytics. Only the user can create and list their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if isOwner(userId)
     * @deny (update, delete) always
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        allow list, get, create: if isOwner(userId);
        allow update, delete: if false;
    }

    // --- Helper Functions ---
    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource, and it exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {bool} True if the user is the owner and resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}