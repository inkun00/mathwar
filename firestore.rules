/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with role-based access control
 * where appropriate. It prioritizes data ownership and prevents unauthorized access
 * or modification. It assumes that user authentication is handled separately via
 * Firebase Authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /countries/{countryId}: Stores user-created countries.
 * - /land_tiles/{landTileId}: Stores game map land tiles.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user attempts at problems.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores wrong answers for review.
 *
 * Key Security Decisions:
 * - Users can only create, read, update and list their own user profiles.
 * - Countries are publicly readable, but creation and modification are restricted.
 * - Land tiles are publicly readable, but creation and modification are restricted.
 * - Problem attempts are scoped to the user.
 * - Wrong answers are stored in a user-scoped subcollection.
 *
 * Denormalization for Authorization:
 *  - The `Country` entity has a `createdBy` field. When a user creates a `Country`, the
 *  `createdBy` field must match the user's `uid`. Updates and deletes are only allowed if the
 *  `createdBy` field matches the user's `uid`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a profile with ID 'user123'.
     * @allow (get, list) User with UID 'user123' can read their profile.
     * @deny (get, list) Unauthenticated user cannot read any profiles.
     * @allow (update) User with UID 'user123' can update their profile.
     * @deny (update) User with UID 'user456' cannot update profile 'user123'.
     * @principle Enforces document ownership for writes; allows public reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false; // Deletion is not allowed

    }


    /**
     * @description Manages wrong answers for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) User with UID 'user123' can create a wrong answer under their ID.
     * @deny (create) User with UID 'user456' cannot create a wrong answer under user 'user123's ID.
     * @allow (get, list) User with UID 'user123' can read wrong answers under their ID.
     * @deny (get, list) User with UID 'user456' cannot read wrong answers under user 'user123's ID.
     * @allow (update) User with UID 'user123' can update a wrong answer under their ID.
     * @deny (update) User with UID 'user456' cannot update a wrong answer under user 'user123's ID.
     * @allow (delete) User with UID 'user123' can delete a wrong answer under their ID.
     * @deny (delete) User with UID 'user456' cannot delete a wrong answer under user 'user123's ID.
     * @principle Enforces user-specific data access.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function isOwner(userId) {
            return request.auth.uid == userId;
          }

          function isExistingOwner(wrongAnswerId) {
            return get(/databases/$(database)/documents/users/$(userId)/wrong_answers/$(wrongAnswerId)).data.userId == request.auth.uid;
          }

          allow get: if isSignedIn() && isOwner(userId);
          allow list: if isSignedIn() && isOwner(userId);
          allow create: if isSignedIn() && isOwner(userId);
          allow update: if isSignedIn() && isExistingOwner(wrongAnswerId);
          allow delete: if isSignedIn() && isExistingOwner(wrongAnswerId);
    }

    /**
     * @description Manages country data.
     * @path /countries/{countryId}
     * @allow (create) User with UID 'user123' can create a country if request.resource.data.createdBy == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a country if request.resource.data.createdBy == 'user123'.
     * @allow (get, list) Any signed in user can read country data.
     * @deny (update) User with UID 'user456' cannot update country created by 'user123'.
     * @principle Enforces creator-only writes; allows public reads.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(countryId) {
        return get(/databases/$(database)/documents/countries/$(countryId)).data.createdBy == request.auth.uid;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isOwner(countryId);
      allow delete: if isSignedIn() && isOwner(countryId);
    }

    /**
     * @description Manages land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any signed in user can read land tile data.
     * @deny (create) No open writes.
     * @principle Enforces a closed write model, only reads for signed in users.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Stores each attempt a user makes on a problem for analytics. Only the user can create and list their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) User with UID 'user123' can create a problem attempt under their ID if request.resource.data.userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a problem attempt under user 'user123's ID.
     * @allow (get, list) User with UID 'user123' can read problem attempts under their ID.
     * @deny (get, list) User with UID 'user456' cannot read problem attempts under user 'user123's ID.
     * @principle Enforces user-specific data access.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }
  }
}