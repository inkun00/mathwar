rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) - If the authenticated user's UID matches the userId.
     * @allow (get, update, delete) - If the authenticated user's UID matches the userId and document exists.
     * @deny (list) - Always denies listing users.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId));
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to countries and enforces ownership for writes.
     * @path /countries/{countryId}
     * @allow (get, list) - Any authenticated user can read all countries.
     * @allow (create) - Only the creating user can create countries, and the `createdBy` field must match their UID.
     * @allow (update, delete) - Only the owner (creator) of the country can modify/delete it.
     * @deny (none) - No requests are denied if they meet the allow conditions.
     * @principle Public read, owner-only writes with ownership validation.
     */
    match /countries/{countryId} {
      function isOwner(ownerId) {
        return request.auth != null && request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && existsAfter(/databases/$(database)/documents/countries/$(countryId));
      }

      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if isExistingOwner(resource.data.createdBy);
      allow delete: if isExistingOwner(resource.data.createdBy);
    }

    /**
     * @description Allows public read access to land tiles and enforces ownership for writes.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any user can read any land tile.
     * @allow (create) - Requires authentication, and the `ownerId` field must match the authenticated user's UID.
     * @allow (update, delete) - Requires authentication, and the `ownerId` field must match the authenticated user's UID of the existing document.
     * @principle Public read, owner-only writes with ownership validation.
     */
    match /land_tiles/{landTileId} {
      function isOwner(ownerId) {
        return request.auth != null && request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && existsAfter(/databases/$(database)/documents/land_tiles/$(landTileId));
      }

      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Allows public read access to problems.
     * @path /problems/{problemId}
     * @allow (get, list) - Any user can read any problem.
     * @deny (create, update, delete) - No one can create, update, or delete problems.
     * @principle Public read-only.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Enforces user-ownership for territory expansion records.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - If the authenticated user's UID matches the userId.
     * @allow (get, update, delete) - If the authenticated user's UID matches the userId.
     * @deny (list) - If the authenticated user's UID does not match the userId.
     * @principle Enforces document ownership for all operations within a user's territory expansions.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(/databases/$(database)/documents/users/$(userId)/territory_expansions/$(territoryExpansionId));
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}