/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansion records.
 * LandTiles and Problems are publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the user can modify their own profile.
 * - /land_tiles/{landTileId}: Stores land tiles. Publicly readable, but ownership is required for modifications.
 * - /problems/{problemId}: Stores math problems. Publicly readable.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansion events. Only the user can modify their own expansion records.
 *
 * Key Security Decisions:
 * - Users can only manage their own profiles and territory expansion records.
 * - LandTiles and Problems are publicly readable to facilitate gameplay.
 * - LandTiles include the ownerId for authorization independence.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user can read and modify their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile if authenticated as 'user123'.
     * @allow (get) User with ID 'user123' can read their profile if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update their profile if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete their profile if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create a profile if authenticated as 'user456'.
     * @deny (get) User with ID 'user123' cannot read a different profile if authenticated as 'user456'.
     * @deny (update) User with ID 'user123' cannot update a different profile if authenticated as 'user456'.
     * @deny (delete) User with ID 'user123' cannot delete a different profile if authenticated as 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in and owns the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Helper function to check if the user is signed in and owns the document AND the resource exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing of all users

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to land tiles. Land tiles are publicly readable, but modifications require ownership.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any user can read a land tile.
     * @allow (list) Any user can list land tiles.
     * @deny (create) Any user cannot create a land tile without being authenticated as the owner.
     * @deny (update) Any user cannot update a land tile without being authenticated as the owner.
     * @deny (delete) Any user cannot delete a land tile without being authenticated as the owner.
     * @principle Allows public reads but restricts writes to the owner.
     */
    match /land_tiles/{landTileId} {
      // Helper function to check if the user is signed in and owns the document based on the ownerId field.
      function isOwner(ownerId) {
        return request.auth != null && request.auth.uid == ownerId;
      }

      // Helper function to check if the user is signed in and owns the document based on the ownerId field AND the resource exists.
      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to math problems. Math problems are publicly readable.
     * @path /problems/{problemId}
     * @allow (get) Any user can read a math problem.
     * @allow (list) Any user can list math problems.
     * @deny (create) No one can create a problem. // TODO: Determine who can create problems (admin role?).
     * @deny (update) No one can update a problem. // TODO: Determine who can update problems (admin role?).
     * @deny (delete) No one can delete a problem. // TODO: Determine who can delete problems (admin role?).
     * @principle Allows public reads but restricts writes.
     */
    match /problems/{problemId} {
      allow get: if true;
      allow list: if true;

      // TODO: Determine who can create, update, and delete problems (e.g., admin role).
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to territory expansion records for each user. Only the user can manage their own records.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) User with ID 'user123' can create a territory expansion record under their ID if authenticated as 'user123'.
     * @allow (get) User with ID 'user123' can read a territory expansion record under their ID if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update a territory expansion record under their ID if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete a territory expansion record under their ID if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create a territory expansion record under 'user456' if authenticated as 'user123'.
     * @deny (get) User with ID 'user123' cannot read a territory expansion record under 'user456' if authenticated as 'user123'.
     * @deny (update) User with ID 'user123' cannot update a territory expansion record under 'user456' if authenticated as 'user123'.
     * @deny (delete) User with ID 'user123' cannot delete a territory expansion record under 'user456' if authenticated as 'user123'.
     * @principle Enforces document ownership within the user's data tree.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      // Helper function to check if the user is signed in and owns the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Helper function to check if the user is signed in and owns the document AND the resource exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}