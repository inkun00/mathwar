rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (get, list) User with any auth can read a user's profile to facilitate game state.
     * @allow (update) User with matching ID can update their own profile.
     * @deny (create, delete) No one can create or delete user documents directly through Firestore.
     * @deny (update) User cannot update another user's profile.
     * @principle Enforces document ownership for updates and denies unauthorized creation/deletion.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to user's incorrect problem data.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create, get, list, update, delete) User with matching ID can manage their own incorrect problems.
     * @deny (create, get, list, update, delete) User cannot access another user's incorrect problems.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to country data.
     * @path /countries/{countryId}
     * @allow (get, list) Any authenticated user can read the list of countries.
     * @allow (create) Any authenticated user can create a country. The 'createdBy' field must match the user's UID.
     * @deny (update, delete) Only the owner should update/delete, but is not implemented yet.
     * @principle Allows public reads and enforces ownership for creation.
     */
    match /countries/{countryId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any authenticated user can read land tile data.
     * @allow (create, update) Any authenticated user can create a land tile.
     * @deny (delete) Land tiles cannot be deleted by the user.
     * @principle Allows public reads for game state and restricts creation and updates to authenticated users.
     */
    match /land_tiles/{landTileId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to problem attempt data.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) User with matching ID can create problem attempts.
     * @allow (list) User with matching ID can list problem attempts.
     * @deny (get, update, delete) No one can get, update, or delete problem attempts through Firestore.
     * @principle Restricts access to a user's own data tree and write access to creation only.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isSignedIn() {
            return request.auth != null;
        }
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        allow get: if false;
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}