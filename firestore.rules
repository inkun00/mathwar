/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-specific data,
 * while allowing public read access to game-related data like land tiles.
 * Write access to user and country data is restricted to the respective owner.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect math problems for each user.
 * - /countries/{countryId}: Stores information about countries.
 * - /land_tiles/{landTileId}: Stores data for each land tile on the game board.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores data about users attempts to solve math problems.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user document.
 * - Land tiles are publicly readable but only updatable by the tile owner.
 * - Listing of all users is disallowed.
 *
 * Denormalization for Authorization:
 * - Land tiles include an `ownerId` field, enabling direct ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - If the user's auth UID matches the requested userId.
     * @allow (get, update) - If the user's auth UID matches the requested userId.
     * @deny (create) - If the user's auth UID does not match the requested userId.
     * @deny (get, update) - If the user's auth UID does not match the requested userId.
     * @principle Enforces strict user ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is disallowed.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer records for a user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create, list, get, update, delete) - If the user's auth UID matches the requested userId.
     * @deny (create, list, get, update, delete) - If the user's auth UID does not match the requested userId.
     * @principle Enforces user ownership for their learning data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to country records.
     * @path /countries/{countryId}
     * @allow (get, list) - Public read access for all countries.
     * @allow (create, update) - Restricted to the user who created the country.
     * @deny (create, update) - If the user is not the owner of the country.
     * @principle Allows public discovery of countries, but restricts modifications to the owner.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile records.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Public read access to all land tiles.
     * @allow (create, update) - Restricted to the owner of the land tile.
     * @deny (create, update) - If the user is not the owner of the land tile.
     * @principle Allows public view of the game board, but restricts modifications to the tile owner.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts for a user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create, list, get) - If the user's auth UID matches the requested userId.
     * @deny (create, list, get) - If the user's auth UID does not match the requested userId.
     * @principle Enforces user ownership for their problem-solving history.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }
    
    /**
     * @description Controls access to join requests.
     * @path /join_requests/{requestId}
     * @allow (list, get, create, update) - If the user is authenticated.
     * @principle Allows any authenticated user to interact with join requests.
     */
    match /join_requests/{requestId} {
        allow list, get: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }
    
    /**
     * @description Controls access to alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (list, get, create, update) - If the user is authenticated.
     * @principle Allows any authenticated user to interact with alliance requests.
     */
    match /alliance_requests/{requestId} {
        allow list, get: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    //------------------- Helper Functions -------------------

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the resource's owner ID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
     function isExistingOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId && resource != null;
    }
  }
}