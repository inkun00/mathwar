/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-centric security model for the Decimal Conquest game.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect math problems for review, only accessible by the user.
 * - /countries/{countryId}: Stores country data, created by users and accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Stores game map tile data, accessible to all authenticated users.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user problem attempts for analytics; only accessible by the user.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data and associated subcollections (wrong_answers, problem_attempts).
 * - Countries and LandTiles are publicly readable by all authenticated users.
 * - User listing is disabled for the /users collection to protect privacy.
 *
 * Denormalization for Authorization:
 * - The rules rely on path-based authorization (e.g., /users/{userId}) and validate that the document ID matches the authenticated user's UID where applicable.  This avoids the need for costly `get()` operations.
 *
 * Structural Segregation:
 * - User-specific private data (wrong_answers, problem_attempts) is stored in user subcollections to provide a clear separation of concerns and simplify access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @deny (create) Users cannot create documents directly in the /users collection. User documents are created via backend user creation flows and should not be directly written via the client.
     * @deny (list) Listing all users is disallowed for privacy reasons.
     * @deny (delete) Users cannot delete their profiles directly.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if false;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's incorrect problem answers.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) Authenticated user can create wrong answers under their own user ID.
     * @allow (get) Authenticated user can read wrong answers under their own user ID.
     * @allow (list) Authenticated user can list wrong answers under their own user ID.
     * @allow (update) Authenticated user can update wrong answers under their own user ID.
     * @allow (delete) Authenticated user can delete wrong answers under their own user ID.
     * @deny (create) Another user cannot create a wrong answer under someone else's user ID.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to countries.
     * @path /countries/{countryId}
     * @allow (get) Any authenticated user can read country data.
     * @allow (list) Any authenticated user can list countries.
     * @allow (create) Any authenticated user can create a country.
     * @deny (update) Countries cannot be updated by any user.
     * @deny (delete) Countries cannot be deleted by any user.
     * @principle Allows public read access with owner-only writes (create).
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any authenticated user can read land tile data.
     * @allow (list) Any authenticated user can list land tiles.
     * @allow (create) Any authenticated user can create land tiles.
     * @allow (update) Any authenticated user can update land tiles.
     * @deny (delete) Land tiles cannot be deleted.
     * @principle Allows public read access with owner-only writes (create and update).
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if false;
    }

     /**
      * @description Controls access to a user's problem attempts.
      * @path /problem_attempts/{userId}/attempts/{attemptId}
      * @allow (create) Authenticated user can create problem attempts under their own user ID.
      * @allow (get) Authenticated user can read problem attempts under their own user ID.
      * @allow (list) Authenticated user can list problem attempts under their own user ID.
      * @deny (update) Problem attempts cannot be updated.
      * @deny (delete) Problem attempts cannot be deleted.
      * @deny (create) Another user cannot create a problem attempt under someone else's user ID.
      * @principle Restricts access to a user's own data tree.
      */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}