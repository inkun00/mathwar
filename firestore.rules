/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with a focus on ownership.
 * Users can only modify their own data, with some exceptions for public data like land tiles.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible for reading by any logged-in user, but writable only by the user themselves.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores problems answered incorrectly by a specific user, accessible only by that user.
 * - /countries/{countryId}: Stores country data, readable by any logged-in user. Only creates are allowed.
 * - /land_tiles/{landTileId}: Stores land tile data, accessible for reading and writing by any logged-in user (for gameplay).
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user problem attempts, only accessible to the user who created them.
 *
 * Key Security Decisions:
 * - Users cannot list all users.
 * - The land_tiles collection is open for modification by any authenticated user. This is intentional for game play.
 *
 * Denormalization for Authorization:
 *  - The `LandTile` and `Country` entities could benefit from a `ownerId` field to restrict modifications.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get) Signed-in user can read any user profile for game state.
     * @allow (update) Signed-in user can update their own profile.
     * @deny (create) No one can create a user document through direct write, it's handled by auth.
     * @deny (delete) Users cannot delete their profiles.
     * @deny (update) Signed-in user cannot update another user profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer records for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) Signed-in user can create wrong answer records for themselves.
     * @allow (get) Signed-in user can get wrong answer records for themselves.
     * @allow (list) Signed-in user can list wrong answer records for themselves.
     * @allow (update) Signed-in user can update wrong answer records for themselves.
     * @allow (delete) Signed-in user can delete wrong answer records for themselves.
     * @deny (create) Signed-in user cannot create wrong answer records for other users.
     * @deny (get) Signed-in user cannot get wrong answer records for other users.
     * @deny (list) Signed-in user cannot list wrong answer records for other users.
     * @deny (update) Signed-in user cannot update wrong answer records for other users.
     * @deny (delete) Signed-in user cannot delete wrong answer records for other users.
     * @principle Restricts access to a user's own wrong answer records.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to country records.
     * @path /countries/{countryId}
     * @allow (get) Signed-in user can read any country.
     * @allow (list) Signed-in user can list all countries.
     * @allow (create) Signed-in user can create a country.
     * @deny (update) No one can update a country.
     * @deny (delete) No one can delete a country.
     * @principle Allows public read access with owner-only creates.
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile records.
     * @path /land_tiles/{landTileId}
     * @allow (get) Signed-in user can read any land tile.
     * @allow (list) Signed-in user can list all land tiles.
     * @allow (create) Signed-in user can create a land tile.
     * @allow (update) Signed-in user can update a land tile.
     * @deny (delete) No one can delete a land tile.
     * @principle Allows public read and write access for gameplay.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isLandTileExists();
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempt records for a specific user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) Signed-in user can create problem attempt records for themselves.
     * @allow (get) Signed-in user can get problem attempt records for themselves.
     * @allow (list) Signed-in user can list problem attempt records for themselves.
     * @deny (update) No one can update a problem attempt.
     * @deny (delete) No one can delete a problem attempt.
     * @deny (create) Signed-in user cannot create problem attempt records for other users.
     * @deny (get) Signed-in user cannot get problem attempt records for other users.
     * @deny (list) Signed-in user cannot list problem attempt records for other users.
     * @principle Restricts access to a user's own problem attempt records.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if false;
      allow delete: if false;
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to check.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Check if the land tile exists before updating.
     * @return {bool} True if the resource exists
     */
    function isLandTileExists() {
        return resource != null;
    }
  }
}