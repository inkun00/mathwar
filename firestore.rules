/**
 * @file Firestore Security Rules for Decimal Conquest
 *
 * @Core Philosophy:
 * This ruleset enforces a user-centric security model where users primarily have access to their own data.
 * Public read access is granted to some collections (countries, land_tiles) while ensuring only authorized
 * users can create, update, or delete documents.
 *
 * @Data Structure:
 * - /users/{userId}: User profiles, accessible primarily to the owning user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problem attempts, only accessible by the owning user.
 * - /countries/{countryId}: Countries created by users, publicly readable, owner-restricted writes.
 * - /land_tiles/{landTileId}: Land tiles on the game map, publicly readable, owner-restricted writes.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Problem attempts, only accessible by the owning user.
 *
 * @Key Security Decisions:
 * - User listing is explicitly denied to prevent unauthorized data access.
 * - Data consistency checks are enforced on user-scoped subcollections to ensure data integrity.
 * - Read-only access to countries and land tiles is granted to all authenticated users to facilitate game play.
 *
 * @Denormalization for Authorization:
 *  - The `Country` entity contains a `createdBy` field to denote the owner. This ensures that rules on `/countries/{countryId}` can quickly verify ownership without additional reads.
 *  - The `LandTile` entity contains an `ownerId` field to denote the owner. This ensures that rules on `/land_tiles/{landTileId}` can quickly verify ownership without additional reads.
 *
 * @Structural Segregation:
 *  - Private user data (wrong answers, problem attempts) is stored in user-specific subcollections to provide isolation and prevent unauthorized access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Users can read their own profile data and create their own profile.
     * @path /users/{userId}
     * @allow (get) - Authenticated user can get their own profile data.
     *  request.auth.uid: "user123"
     *  resource.id: "user123"
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.id: "user123"
     * @allow (update) - Authenticated user can update their own profile data.
     *  request.auth.uid: "user123"
     *  resource.data.id: "user123"
     * @deny (get) - Another user attempts to read a different user's profile data.
     *  request.auth.uid: "user456"
     *  resource.data.id: "user123"
     * @deny (create) - Creating a profile with an ID that does not match the authenticated user's UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.id: "user456"
     * @deny (update) - Another user attempts to update a different user's profile data.
     *  request.auth.uid: "user456"
     *  resource.data.id: "user123"
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is disallowed
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(userId) && (request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    /**
     * @description Manages incorrect problem attempts for a specific user. Only accessible by that user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get) - Authenticated user can read their own wrong answers.
     *  request.auth.uid: "user123"
     *  resource.data.userId: "user123"
     * @allow (create) - Authenticated user can create a wrong answer entry for themselves.
     *  request.auth.uid: "user123"
     *  request.resource.data.userId: "user123"
     * @allow (update) - Authenticated user can update their own wrong answer entries.
     *  request.auth.uid: "user123"
     *  resource.data.userId: "user123"
     * @allow (delete) - Authenticated user can delete their own wrong answer entries.
     *  request.auth.uid: "user123"
     *  resource.data.userId: "user123"
     * @deny (get) - Another user attempts to read a different user's wrong answers.
     *  request.auth.uid: "user456"
     *  resource.data.userId: "user123"
     * @deny (create) - Another user attempts to create a wrong answer entry for a different user.
     *  request.auth.uid: "user456"
     *  request.resource.data.userId: "user123"
     * @deny (update) - Another user attempts to update a different user's wrong answer entries.
     *  request.auth.uid: "user456"
     *  resource.data.userId: "user123"
     * @deny (delete) - Another user attempts to delete a different user's wrong answer entries.
     *  request.auth.uid: "user456"
     *  resource.data.userId: "user123"
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(userId) && (request.resource.data.userId == resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(userId) && (resource.data.userId == request.auth.uid);
    }

    /**
     * @description Manages countries created by users. Accessible to all authenticated users.
     * @path /countries/{countryId}
     * @allow (get) - Any authenticated user can read a country.
     * @allow (list) - Any authenticated user can list countries.
     * @allow (create) - An authenticated user can create a country, if the createdBy field matches their auth UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.createdBy: "user123"
     * @allow (update) - The country's creator can update the country.
     *  request.auth.uid: "user123"
     *  resource.data.createdBy: "user123"
     * @deny (create) - Creating a country with a createdBy field that does not match the authenticated user's UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.createdBy: "user456"
     * @deny (update) - A user attempts to update a country they did not create.
     *  request.auth.uid: "user456"
     *  resource.data.createdBy: "user123"
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isExistingCountryOwner(resource.data.createdBy);
      allow delete: if false;
    }

    /**
     * @description Manages land tiles on the game map. Accessible to all authenticated users.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any authenticated user can read a land tile.
     * @allow (list) - Any authenticated user can list land tiles.
     * @allow (create) - An authenticated user can create a land tile if the ownerId matches their auth UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.ownerId: "user123"
     * @allow (update) - The land tile's owner can update the land tile.
     *  request.auth.uid: "user123"
     *  resource.data.ownerId: "user123"
     * @deny (create) - Creating a land tile with an ownerId that does not match the authenticated user's UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.ownerId: "user456"
     * @deny (update) - A user attempts to update a land tile they do not own.
     *  request.auth.uid: "user456"
     *  resource.data.ownerId: "user123"
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingLandTileOwner(resource.data.ownerId);
      allow delete: if false;
    }

    /**
     * @description Stores each attempt a user makes on a problem for analytics. Only the user can create and list their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get) - The user can read their own problem attempts.
     *  request.auth.uid: "user123"
     *  resource.data.userId: "user123"
     * @allow (list) - The user can list their own problem attempts.
     *  request.auth.uid: "user123"
     * @allow (create) - The user can create a problem attempt, if the userId matches their auth UID.
     *  request.auth.uid: "user123"
     *  request.resource.data.userId: "user123"
     * @deny (get) - Another user attempts to read a different user's problem attempts.
     *  request.auth.uid: "user456"
     *  resource.data.userId: "user123"
     * @deny (create) - Another user attempts to create a problem attempt for a different user.
     *  request.auth.uid: "user456"
     *  request.resource.data.userId: "user123"
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isExistingCountryOwner(createdBy) {
      return isSignedIn() && request.auth.uid == createdBy && resource != null;
    }

        function isExistingLandTileOwner(ownerId) {
          return isSignedIn() && request.auth.uid == ownerId && resource != null;
        }
  }
}