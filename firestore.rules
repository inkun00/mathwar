/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a mix of user-ownership and public-read with restricted-write patterns. User-specific data is stored under /users/{userId}, while shared game data resides in top-level collections. Write access to land_tiles is now disabled and moved to Cloud Functions to allow for token validation.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores a user's incorrect problem attempts.
 * - /countries/{countryId}: Stores country information.
 * - /land_tiles/{landTileId}: Stores game board tile information.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores individual attempts.
 * - /join_requests/{requestId}: Stores requests from users to join a country.
 * - /alliance_requests/{requestId}: Stores requests from countries to form an alliance.
 *
 * Key Security Decisions:
 * - Users can only create, update, and delete their own profile data under /users/{userId}.
 * - Public read access is granted for countries and land_tiles, but write access to land_tiles is disabled.
 * - Listing all users is not allowed.
 * - Write access for land_tiles is disabled; any write should be handled by Cloud Functions with token validation
 *
 * Denormalization for Authorization:
 *  - The `LandTile` entity requires an `ownerId` field for write authorization (now handled by Cloud Functions).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) - If the user's auth UID matches the userId.
     * @allow (get, list, update) - If the user is the owner of the profile.
     * @deny (delete) - Users cannot delete their profiles through direct Firestore access.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      // Function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Allow a user to create their own profile if the userId matches their auth UID.
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Allow read access if the user is the owner.
      allow get, list: if isOwner(userId);

      // Allow updates if the user is the owner and the user ID is immutable.
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;

      // Prevent deletion of user documents.
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer data for a user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) - If the user's auth UID matches the userId.
     * @allow (get, list, update, delete) - If the user is the owner of the wrong answer data.
     * @deny (create) - If the userId in the document doesn't match the path.
     * @principle Enforces user-ownership for wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      // Function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Allow listing wrong answers if the user is the owner.
      allow list: if isOwner(userId);

      // Allow reading a specific wrong answer if the user is the owner.
      allow get: if isOwner(userId);

      // Allow creation of wrong answers if the user is the owner and the userId in the document matches the path.
      allow create: if isOwner(userId) && request.resource.data.userId == userId;

      // Allow updates if the user is the owner and the userId in the document matches the path.
      allow update: if isOwner(userId) && request.resource.data.userId == userId;

      // Allow deletion if the user is the owner.
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to country data.
     * @path /countries/{countryId}
     * @allow (get, list) - Public read access.
     * @allow (create, update) - Authenticated users can create and update.
     * @deny (delete) - Countries cannot be deleted through direct Firestore access.
     * @principle Allows public read access with authenticated user write access.
     */
    match /countries/{countryId} {
      // Allow public read access.
      allow get, list: if true;

      // Allow authenticated users to create countries.
      allow create: if request.auth != null;

      // Allow authenticated users to update countries.
      allow update: if request.auth != null;

      // Prevent deletion of country documents.
      allow delete: if false;
    }

   /**
     * @description Controls access to land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Public read access to land tile data.
     * @deny (write) - Disables direct client writes to land_tiles; writes should be handled by Cloud Functions.
     * @principle Public read, all writes are disabled. Writes are now handled by cloud functions for token validation.
     */
    match /land_tiles/{landTileId} {
      allow read: if request.auth != null;
      // Disables direct client writes, now handled by cloud functions
      allow write: if false;
    }

    /**
     * @description Controls access to problem attempt data.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) - If the user's auth UID matches the userId.
     * @deny (update, delete) - Problem attempts cannot be updated or deleted directly.
     * @principle Enforces user-ownership for problem attempt data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      // Function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Allow listing problem attempts if the user is the owner.
      allow list: if isOwner(userId);

      // Allow reading a specific problem attempt if the user is the owner.
      allow get: if isOwner(userId);

      // Allow creation of problem attempts if the user is the owner and the userId in the document matches the path.
      allow create: if isOwner(userId) && request.resource.data.userId == userId;

      // Prevent updates of problem attempt documents.
      allow update: if false;

      // Prevent deletion of problem attempt documents.
      allow delete: if false;
    }
    /**
     * @description Controls access to join requests.
     * @path /join_requests/{requestId}
     * @allow (get, list, create, update) - Authenticated users can perform these operations.
     * @deny (delete) - Join requests cannot be deleted through direct Firestore access.
     */
    match /join_requests/{requestId} {
      // Allow listing join requests if the user is authenticated.
      allow list: if request.auth != null;

      // Allow reading a specific join request if the user is authenticated.
      allow get: if request.auth != null;

      // Allow creation of join requests if the user is authenticated.
      allow create: if request.auth != null;

      // Allow updates of join request documents if the user is authenticated.
      allow update: if request.auth != null;

      // Prevent deletion of join request documents.
      allow delete: if false;
    }

    /**
     * @description Controls access to alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (get, list, create, update) - Authenticated users can perform these operations.
     * @deny (delete) - Alliance requests cannot be deleted through direct Firestore access.
     */
    match /alliance_requests/{requestId} {
      // Allow listing alliance requests if the user is authenticated.
      allow list: if request.auth != null;

      // Allow reading a specific alliance request if the user is authenticated.
      allow get: if request.auth != null;

      // Allow creation of alliance requests if the user is authenticated.
      allow create: if request.auth != null;

      // Allow updates of alliance request documents if the user is authenticated.
      allow update: if request.auth != null;

      // Prevent deletion of alliance request documents.
      allow delete: if false;
    }
  }
}