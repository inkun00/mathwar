rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @file Overview
     * This ruleset enforces a user-ownership model for user profiles and their associated data,
     * while allowing public read access to game-related data like countries and land tiles.
     *
     * Data Structure:
     * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
     * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problems for a user, accessible only to the user.
     * - /countries/{countryId}: Stores countries, publicly readable but restricted creation.
     * - /land_tiles/{landTileId}: Stores land tiles, publicly readable with restricted creation/updates.
     * - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempts, only accessible to the user.
     *
     * Key Security Decisions:
     * - Users can only read and write their own profiles and associated data.
     * - Public read access is granted for countries and land tiles.
     * - The rules validate that the `userId` in subcollections matches the `userId` in the path.
     * - The rules explicitly deny any operations not explicitly allowed.
     *
     * Denormalization for Authorization:
     *  - The `LandTile` and `Country` entities do not have an explicit owner.
     *  - The current ruleset relies on the path-based authorization model.
     */

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (update) if isOwner(userId)
     * @deny (create, delete) always
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Verify that the user is signed in.
      allow get, list: if isSignedIn();
      // Only the user can update their own profile.
      allow update: if isOwner(userId);
      // No one can create or delete user profiles via the API.
      allow create, delete: if false;
    }

    /**
     * @description Manages user-specific wrong answer data.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get, list, create, update, delete) if isOwner(userId)
     * @deny If the user is not the owner.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      // Only the owner can read, create, update, and delete their own wrong answers.
      allow get, list, create, update, delete: if isOwner(userId);
    }

    /**
     * @description Manages country documents.
     * @path /countries/{countryId}
     * @allow (get, list) always
     * @allow (create) if isSignedIn()
     * @deny (update, delete) always
     * @principle Public read, restricted write.
     */
    match /countries/{countryId} {
      // Everyone can read the countries.
      allow get, list: if true;
      // Only signed-in users can create countries.
      allow create: if isSignedIn();
      // No one can update or delete countries.
      allow update, delete: if false;
    }

    /**
     * @description Manages land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) always
     * @allow (create, update) if isSignedIn()
     * @deny (delete) always
     * @principle Public read, restricted write.
     */
    match /land_tiles/{landTileId} {
      // Everyone can read the land tiles.
      allow get, list: if true;
      // Only signed-in users can create and update land tiles.
      allow create, update: if isSignedIn();
      // No one can delete land tiles.
      allow delete: if false;
    }

    /**
     * @description Manages problem attempts for users.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) if isOwner(userId)
     * @deny (update, delete) always
     * @principle Restricts access to a user's own data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      // Only the user can create and list their own attempts.
      allow get, list, create: if isOwner(userId);
      // No one can update or delete problem attempts.
      allow update, delete: if false;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     * @param {string} userId The user ID to check.
     * @return {bool} True if the user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}