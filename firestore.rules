/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with owner-only access to user-specific data
 * and public read access to shared game data. It leverages denormalization by expecting specific
 * ownership fields (e.g., `createdBy`, `ownerId`) within documents to simplify authorization checks.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect math problems for review.
 * - /countries/{countryId}: Stores countries created by users.
 * - /land_tiles/{landTileId}: Stores game map tiles.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user attempts on math problems.
 *
 * Key Security Decisions:
 * - Users can only create and modify their own profiles.
 * - Only authenticated users can access countries and land tiles.
 * - map_aggregates: Public read for all authenticated users.
 *
 * Denormalization for Authorization:
 *  - The rules assume the presence of 'ownerId', 'createdBy', and 'userId' fields in relevant documents
 *    to quickly verify ownership without additional `get()` calls. For example, the `countries` collection
 *    requires a `createdBy` field to identify the country's owner.
 *
 * Structural Segregation:
 *  - Private user data (wrong answers, problem attempts) is stored in user-specific subcollections to
 *    ensure only the owning user can access it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user owns the existing document.
     *              This function combines the ownership check with an existence check.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 creates their own profile.
     * @allow (get) User nZdE0ay5wERDLPHasKVzIRa6aWk2 reads their own profile.
     * @deny (update) User abc attempts to update user nZdE0ay5wERDLPHasKVzIRa6aWk2's profile.
     * @principle Enforces user-ownership; users can only manage their own profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Rules for the /users/{userId}/wrong_answers/{wrongAnswerId} collection.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 creates a wrong answer entry in their own profile.
     * @allow (get) User nZdE0ay5wERDLPHasKVzIRa6aWk2 retrieves a wrong answer entry from their own profile.
     * @deny (update) User abc attempts to update a wrong answer entry in user nZdE0ay5wERDLPHasKVzIRa6aWk2's profile.
     * @principle Enforces user-ownership; only the owner can manage their wrong answers.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /countries/{countryId} collection.
     * @path /countries/{countryId}
     * @allow (create) Authenticated user creates a country. The createdBy field must match the user ID.
     * @allow (get) Any authenticated user can read country data.
     * @deny (update) User attempts to update a country they did not create.
     * @principle Public read access for authenticated users, owner-only writes.
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Rules for the /land_tiles/{landTileId} collection.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any authenticated user can read land tile data.
     * @allow (create) Any authenticated user can create a land tile.
     * @deny (update) Non-authenticated user attempts to update land tile data.
     * @principle Public read access for authenticated users, owner-only writes.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Rules for the /problem_attempts/{userId}/attempts/{attemptId} collection.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) User creates a problem attempt in their own profile.
     * @allow (list) User lists problem attempts in their own profile.
     * @deny (update) User attempts to update a problem attempt in another user's profile.
     * @principle Enforces user-ownership; only the owner can manage their problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /map_aggregates collection.
     * @path /map_aggregates
     * @allow (list) All authenticated users can read data.
     * @principle Public read access for all authenticated users.
     */
    match /map_aggregates {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}