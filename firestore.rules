/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and their associated data (wrong answers, problem attempts).
 * Countries and land tiles are publicly readable, but writes are restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect math problems for a specific user.
 * - /countries/{countryId}: Stores country data, created by users.
 * - /land_tiles/{landTileId}: Stores land tile data for the game map.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's math problem attempts.
 *
 * Key Security Decisions:
 * - User listing is allowed to facilitate game state.
 * - Countries and land tiles are publicly readable.
 * - Write access to countries is restricted to authenticated users and should ideally be restricted to the user who created the country by comparing the createdBy property.
 * - Land Tiles can be updated by any authenticated user. This may need to be revisited for a more permissioned approach.
 *
 * Denormalization for Authorization:
 * - Country documents should ideally contain a `createdBy` field to identify the user who created it, allowing for owner-based write restrictions. Currently, anyone can create countries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read their own profile data and list all users. Only the user can update their own profile.
     * @path /users/{userId}
     * @allow (get, list) if true
     * @allow (update) if isSignedIn() && isOwner(userId)
     * @deny (create, delete) if true
     * @principle Enforces document ownership for updates. Allows public reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get, list: if true;
      allow create: if false;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Allows a user to manage their own wrong answer records.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if isSignedIn() && isOwner(userId)
     * @deny None (access is strictly controlled by ownership)
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get, create, update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows anyone to read and list countries.  Only authenticated users can create new countries. Updates and deletes are not permitted.
     * @path /countries/{countryId}
     * @allow (list, get) if true
     * @allow (create) if isSignedIn()
     * @deny (update, delete) if true
     * @principle Allows public reads, restricts writes to authenticated users only.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow list, get: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with a createdBy field.
      allow update, delete: if false;
    }

    /**
     * @description Allows anyone to read and list land tiles.  Only authenticated users can create and update land tiles.  Deletion is not permitted.
     * @path /land_tiles/{landTileId}
     * @allow (list, get) if true
     * @allow (create, update) if isSignedIn()
     * @deny (delete) if true
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow list, get: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Allows a user to create and list their own problem attempts for analytics.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if isSignedIn() && isOwner(userId)
     * @deny (update, delete) if true
     * @principle Enforces document ownership. Only the user can create and list their own attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get, create: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }
  }
}