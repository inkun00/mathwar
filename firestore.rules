/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with owner-only access to user profiles and related data,
 * while allowing public read access to game-related data like countries and land tiles. It balances data
 * accessibility for gameplay with the need to protect user privacy and prevent unauthorized modifications.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problem attempts, only accessible to the owning user.
 * - /countries/{countryId}: Stores country data, publicly readable and writable with creator ownership enforced.
 * - /land_tiles/{landTileId}: Stores land tile data, publicly readable and writable with no ownership enforced.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user problem attempts, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - User profiles (/users/{userId}) are strictly controlled, with only the owning user allowed to modify their data.
 * - Countries (/countries/{countryId}) are publicly readable, but creation is open for prototyping.
 * - Land tiles (/land_tiles/{landTileId}) are fully open for prototyping.
 *
 * Denormalization for Authorization:
 *  - The `Country` entity has a `createdBy` field to enable owner-only writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles. Only the user can read and modify their own profile.
     * @path /users/{userId}
     * @allow (get, list, update) if the user is the owner of the profile.
     * @deny (create, delete) always.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId);
      allow create: if false;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages incorrect problem attempts for a user. Only the user can access their own data.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if the user is the owner.
     * @deny None.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow list, get, create, update, delete: if isOwner(userId);
    }

    /**
     * @description Manages countries. Allows any authenticated user to read country data, but restricts creation.
     * @path /countries/{countryId}
     * @allow (get, list) always.
     * @allow (create) if request.auth is not null.
     * @deny (update, delete) always.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tiles on the game map. Accessible to all authenticated users.
     * @path /land_tiles/{landTileId}
     * @allow (get, list, create, update) always.
     * @deny (delete) always.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

     /**
      * @description Stores each attempt a user makes on a problem for analytics. Only the user can create and list their own attempts.
      * @path /problem_attempts/{userId}/attempts/{attemptId}
      * @allow (list, get, create) if the user is the owner.
      * @deny (update, delete) always.
      * @principle Restricts access to a user's own data tree.
      */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isOwner(userId) {
          return request.auth != null && request.auth.uid == userId;
        }
        allow list, get, create: if isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}