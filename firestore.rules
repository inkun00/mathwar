/**
 * @fileOverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with role-based access control for certain operations. Users primarily have access to their own data, while some data is publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible by the user themselves.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problems, accessible only by the owning user.
 * - /countries/{countryId}: Stores country data, publicly readable, but writable only with proper authorization.
 * - /land_tiles/{landTileId}: Stores game map data, publicly readable, but writable only with proper authorization.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempts, accessible only by the owning user.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed unless explicitly required and secured.
 * - Default security posture is strict: explicit `allow` rules are required for all operations.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `request.auth.uid` to determine the current user. The rules assume all write requests will populate the `ownerId` or `createdBy` fields correctly.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles.  Users can read their own profile data.
     * @path /users/{userId}
     * @allow (get) User A with UID "user_abc" can read their own profile at /users/user_abc.
     * @deny (get) User A with UID "user_abc" cannot read User B's profile at /users/user_xyz.
     * @allow (create) User A with UID "user_abc" can create their own profile at /users/user_abc if the document id matches their uid.
     * @deny (create) User A with UID "user_abc" cannot create User B's profile at /users/user_xyz.
     * @allow (update) User A with UID "user_abc" can update their own profile at /users/user_abc.
     * @deny (update) User A with UID "user_abc" cannot update User B's profile at /users/user_xyz.
     * @principle Enforces document ownership for reads and writes; validates ownership on create.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages wrong answer records for a user.  Only the user can access their own wrong answers.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get) User A with UID "user_abc" can read a wrong answer record from /users/user_abc/wrong_answers/wrong_answer_1.
     * @deny (get) User A with UID "user_abc" cannot read a wrong answer record from /users/user_xyz/wrong_answers/wrong_answer_1.
     * @allow (list) User A with UID "user_abc" can list wrong answer records from /users/user_abc/wrong_answers.
     * @deny (list) User A with UID "user_abc" cannot list wrong answer records from /users/user_xyz/wrong_answers.
     * @allow (create) User A with UID "user_abc" can create a wrong answer record in /users/user_abc/wrong_answers.
     * @deny (create) User A with UID "user_abc" cannot create a wrong answer record in /users/user_xyz/wrong_answers.
     * @allow (update) User A with UID "user_abc" can update a wrong answer record in /users/user_abc/wrong_answers.
     * @deny (update) User A with UID "user_abc" cannot update a wrong answer record in /users/user_xyz/wrong_answers.
     * @allow (delete) User A with UID "user_abc" can delete a wrong answer record in /users/user_abc/wrong_answers.
     * @deny (delete) User A with UID "user_abc" cannot delete a wrong answer record in /users/user_xyz/wrong_answers.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
            return request.auth.uid == resource.data.userId;
        }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages country data.  All countries are publicly readable, but restricted writes.
     * @path /countries/{countryId}
     * @allow (get) Any authenticated user can read country data.
     * @allow (list) Any authenticated user can list countries.
     * @deny (create) Any user cannot create a country. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) Any user cannot update a country. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes.
     */
    match /countries/{countryId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false;
    }

    /**
     * @description Manages land tile data.  All land tiles are publicly readable.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any authenticated user can read land tile data.
     * @allow (list) Any authenticated user can list land tiles.
     * @deny (create) Any user cannot create a land tile. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @deny (update) Any user cannot update a land tile. // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false;
    }

    /**
     * @description Manages problem attempts for a user.  Only the user can access their own problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get) User A with UID "user_abc" can read a problem attempt from /problem_attempts/user_abc/attempts/attempt_1.
     * @deny (get) User A with UID "user_abc" cannot read a problem attempt from /problem_attempts/user_xyz/attempts/attempt_1.
     * @allow (list) User A with UID "user_abc" can list problem attempts from /problem_attempts/user_abc/attempts.
     * @deny (list) User A with UID "user_abc" cannot list problem attempts from /problem_attempts/user_xyz/attempts.
     * @allow (create) User A with UID "user_abc" can create a problem attempt in /problem_attempts/user_abc/attempts.
     * @deny (create) User A with UID "user_abc" cannot create a problem attempt in /problem_attempts/user_xyz/attempts.
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}