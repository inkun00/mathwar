/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with role-based access control
 * for managing game data. Users can only modify their own profiles and data, while
 * certain collections are publicly readable.  Data validation is relaxed to allow rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problems for a specific user.
 * - /countries/{countryId}: Stores countries created by users.
 * - /land_tiles/{landTileId}: Stores land tiles on the game map.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's attempts at solving math problems.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents.
 * - Countries and land tiles are publicly readable, but writes are restricted to authenticated users.
 * - Listing all users is disallowed.
 *
 * Denormalization for Authorization:
 * - The `ownerId` field in `LandTile` documents is crucial for determining ownership, allowing for direct rule enforcement without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, update) if isSignedIn() && isOwner(userId)
     * @deny (create, delete)
     * @deny (get, update) if !isSignedIn()
     * @principle Enforces document ownership for writes, requires authentication for all access.
     */
    match /users/{userId} {
      // Verify user is signed in
      function isSignedIn() {
          return request.auth != null;
      }

      // Verify that the userId matches the authenticated user's uid
      function isOwner(userId) {
          return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if false;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages access to wrong answer entries for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create, list, get, update, delete) if isSignedIn() && isOwner(userId)
     * @deny (create, list, get, update, delete) if !isSignedIn() || !isOwner(userId)
     * @principle Restricts access to a user's own incorrect problem data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isSignedIn() {
          return request.auth != null;
        }

        // Verify that the userId matches the authenticated user's uid
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        allow list: if isSignedIn() && isOwner(userId);
        allow get: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to country documents.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @deny (update, delete)
     * @principle Allows public read access to countries, restricts writes to authenticated users only.
     */
    match /countries/{countryId} {
      function isSignedIn() {
          return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) if true
     * @allow (create, update) if isSignedIn()
     * @deny (delete)
     * @principle Provides public read access to land tiles, restricts writes to authenticated users.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
          return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

      /**
       * @description Manages access to problem attempts for a user.
       * @path /problem_attempts/{userId}/attempts/{attemptId}
       * @allow (create, list, get) if isSignedIn() && isOwner(userId)
       * @deny (update, delete)
       * @principle Restricts access to a user's own problem attempt data.
       */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isSignedIn() {
          return request.auth != null;
        }

        // Verify that the userId matches the authenticated user's uid
        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        allow list: if isSignedIn() && isOwner(userId);
        allow get: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}