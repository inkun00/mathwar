rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) Authenticated user can read any user profile.
     * @allow (create, update) User can only create/update their own profile.
     * @deny (delete) Users cannot delete their profiles through direct requests.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get, list: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's wrong answer history.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get) User can list and get their own wrong answers.
     * @allow (create) User can create wrong answers under their own user ID.
     * @allow (update, delete) User can update and delete their own wrong answers.
     * @deny Requests that do not match the user ID.
     * @principle Enforces user-ownership for wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        allow list, get: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
    }

    /**
     * @description Controls access to countries.
     * @path /countries/{countryId}
     * @allow (get, list) All authenticated users can read country data.
     * @allow (create) User can create a country, and the `createdBy` field must match their UID.
     * @allow (update) User can update a country they created.
     * @deny (delete) Countries cannot be deleted through direct requests.
     * @principle Enforces public read access with owner-only writes, validates `createdBy` on create.
     */
    match /countries/{countryId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) All authenticated users can read land tile data.
     * @allow (create) User can create a land tile, provided they are authenticated.
     * @allow (update) User can update a land tile.
     * @deny (delete) Land tiles cannot be deleted through direct requests.
     * @principle Enforces public read access with owner-only writes, validates `ownerId` on create.
     */
    match /land_tiles/{landTileId} {
        allow get, list: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
        allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get) User can list and get their own problem attempts.
     * @allow (create) User can create problem attempts under their own user ID.
     * @deny (update, delete) Problem attempts cannot be updated or deleted.
     * @principle Enforces user-ownership for problem attempt data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        allow list, get: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if false;
        allow delete: if false;
    }
  }
}