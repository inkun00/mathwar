rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Allows read access to all authenticated users, but restricts write access to the user owning the profile.
     * @path /users/{userId}
     * @allow (get, list): If the user is signed in.
     * @allow (create, update): If the authenticated user's UID matches the `userId`.
     * @deny (create, update): If the authenticated user's UID does not match the `userId`.
     * @principle Enforces document ownership for writes, allows public read access for signed in users.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

     /**
      * @description Manages wrong answer records for a user. Only the user can access their own wrong answers.
      * @path /users/{userId}/wrong_answers/{wrongAnswerId}
      * @allow (list, get, create, update, delete): If the authenticated user's UID matches the `userId`.
      * @deny (list, get, create, update, delete): If the authenticated user's UID does not match the `userId`.
      * @principle Restricts access to a user's own data.
      */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isOwner(userId) {
            return request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
            return isOwner(userId);
        }

        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }

    /**
     * @description Manages country documents. Allows read access to all authenticated users, but restricts write access to ensure ownership.
     * @path /countries/{countryId}
     * @allow (get, list): If the user is signed in.
     * @allow (create): If the user is signed in. The `createdBy` field in the created document must match the user's UID.
     * @allow (update): If the user is signed in and the user's UID matches the `createdBy` field in the existing document.
     * @deny (create, update, delete): If the `createdBy` field does not match the user's UID.
     * @principle Enforces document ownership for writes, allows public read access.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }
      function isExistingOwner(ownerId) {
        return isOwner(ownerId);
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Manages land tile documents. Allows read access to all authenticated users, but restricts write access to ensure ownership.
     * @path /land_tiles/{landTileId}
     * @allow (get, list): If the user is signed in.
     * @allow (create): If the user is signed in and the `ownerId` field in the created document matches the user's UID.
     * @allow (update): If the user is signed in and the user's UID matches the `ownerId` field in the existing document.
     * @deny (create, update, delete): If the `ownerId` field does not match the user's UID.
     * @principle Enforces document ownership for writes, allows public read access.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }
      function isExistingOwner(ownerId) {
        return isOwner(ownerId);
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Manages problem attempts for a user. Only the user can create and list their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create): If the authenticated user's UID matches the `userId`.
     * @deny (list, get, create): If the authenticated user's UID does not match the `userId`.
     * @principle Restricts access to a user's own data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }
  }
}