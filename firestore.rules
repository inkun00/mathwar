/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-based ownership and public read access where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problems for a user, accessible only to the owning user.
 * - /countries/{countryId}: Countries created by users, publicly readable but writable only by the creating user.
 * - /land_tiles/{landTileId}: Land tiles on the game map, publicly readable, writable by authenticated users.
 * - /problem_attempts/{userId}/attempts/{attemptId}: User problem attempts, accessible only to the owning user.
 * - /join_requests/{requestId}: Requests from users to join a country.
 * - /alliance_requests/{requestId}: Requests from countries to form an alliance.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to prevent information disclosure.
 * - Land tiles are publicly readable to facilitate gameplay.
 *
 * Denormalization for Authorization:
 *  - The `Country` entity has a `createdBy` field to denote ownership. This is used in the security rules to restrict write access to the country's creator.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID "user123" can create their own profile (auth.uid == "user123").
     * @allow (get, update) User with ID "user123" can read and update their own profile (auth.uid == "user123").
     * @deny (get, update) User with ID "user456" cannot read or update user "user123"'s profile (auth.uid != "user123").
     * @deny (list) No one can list all users.
     * @principle Enforces document ownership for reads and updates; allows self-creation.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer records for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) User with ID "user123" can create a wrong answer record under their profile (auth.uid == "user123").
     * @allow (get, list, update, delete) User with ID "user123" can manage their own wrong answer records (auth.uid == "user123").
     * @deny (get, list, update, delete) User with ID "user456" cannot access user "user123"'s wrong answer records (auth.uid != "user123").
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to country documents. Countries are publicly readable, but only the creator can modify them.
     * @path /countries/{countryId}
     * @allow (get, list) Any user can read the country data.
     * @allow (create) User with ID "user123" can create a country with "createdBy": "user123".
     * @allow (update) User with ID "user123" can update a country where resource.data.createdBy == "user123".
     * @deny (update) User with ID "user456" cannot update a country where resource.data.createdBy == "user123".
     * @principle Public read access with owner-only writes.
     */
    match /countries/{countryId} {
        function isOwner() {
            return request.auth.uid == resource.data.createdBy;
        }

        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn() && isOwner();
        allow delete: if false;
    }

    /**
     * @description Controls access to land tile documents. Land tiles are publicly readable and writable.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any user can read the land tile data.
     * @allow (create, update) Any authenticated user can create and update land tiles.
     * @principle Public read and authenticated write access.
     */
    match /land_tiles/{landTileId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to problem attempt records for a specific user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) User with ID "user123" can create a problem attempt record under their profile (auth.uid == "user123").
     * @allow (get, list) User with ID "user123" can read their own problem attempt records (auth.uid == "user123").
     * @deny (get, list) User with ID "user456" cannot access user "user123"'s problem attempt records (auth.uid != "user123").
     * @principle Enforces document ownership for all operations.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to join requests.
     * @path /join_requests/{requestId}
     * @allow (get, list, create, update) Any authenticated user can perform these actions.
     */
    match /join_requests/{requestId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (get, list, create, update) Any authenticated user can perform these actions.
     */
    match /alliance_requests/{requestId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }
  }
}