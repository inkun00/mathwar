rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, create, update) if the user is the owner of the profile.
     * @deny (create, update) if the user ID in the request does not match the authenticated user ID.
     * @deny (list) Listing all users is not permitted.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false; // User deletion is not allowed
    }

    /**
     * @description Controls access to a user's incorrect math problems.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if the user is the owner of the data.
     * @deny (create, update) if the user ID in the request does not match the authenticated user ID.
     * @principle Enforces document ownership for wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get, create, update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to countries.
     * @path /countries/{countryId}
     * @allow (list, get, create, update) to any authenticated user.
     * @principle Allows open reads for country data but restricts writes.
     */
    match /countries/{countryId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow list, get: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (list, get) to anyone.
     * @allow (create, update) if the authenticated user is the owner of the land tile.
     * @deny (create, update) if the authenticated user is not the owner of the land tile.
     * @principle Allows open reads for game map data and enforces ownership for writes.
     */
    match /land_tiles/{landTileId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow list, get: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;
    }

    /**
     * @description Controls access to user problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if the user is the owner of the attempts.
     * @principle Enforces document ownership for user problem attempt data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get, create, update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

     /**
      * @description Controls access to join requests.
      * @path /join_requests/{requestId}
      * @allow (list, get, create, update, delete) to any authenticated user.
      */
     match /join_requests/{requestId} {
        function isSignedIn() {
          return request.auth != null;
        }

        allow list, get, create, update, delete: if isSignedIn();
     }

    /**
     * @description Controls access to alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (list, get, create, update, delete) to any authenticated user.
     */
     match /alliance_requests/{requestId} {
        function isSignedIn() {
          return request.auth != null;
        }

        allow list, get, create, update, delete: if isSignedIn();
     }

    /**
     * @description Controls access to map events.
     * @path /map_events/{eventId}
     * @allow (list, create) to any authenticated user.
     * @principle Allows open creation of map event data for broadcasting.
     */
    match /map_events/{eventId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow list, create: if isSignedIn();
      allow get, update, delete: if false;
    }
  }
}