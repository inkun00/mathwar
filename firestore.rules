/**
 * @file Firestore Security Rules for Decimal Conquest
 * @core_philosophy This ruleset enforces a user-centric security model with role-based access control.
 *  - Users can only read and write their own data, unless explicitly allowed for public or shared resources.
 *  - Data validation is relaxed in the prototyping phase to allow for rapid schema iteration.
 * @data_structure
 *  - /users/{userId}: Stores user profiles. Accessible only to the user themselves.
 *  - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores wrong answers for a user. Accessible only to the user.
 *  - /countries/{countryId}: Stores countries created by users. Publicly readable, but creation is open to authenticated users.
 *  - /land_tiles/{landTileId}: Stores land tiles. Publicly readable, and creation/updates are allowed to authenticated users.
 *  - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempts for a user. Accessible only to the user.
 * @key_security_decisions
 *  - User listing is explicitly denied to protect user privacy.
 * @denormalization_for_authorization
 *  - The `landTiles` entity requires an `ownerId` field for ownership validation.
 *  - The `countries` entity requires a `createdBy` field for ownership validation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @deny (get) Authenticated user cannot read other user profiles.
     * @deny (create) Users cannot create documents directly in the /users collection.
     * @deny (delete) Users cannot delete their profile documents.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      //function isSignedIn() {
      //  return request.auth != null;
      //}

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages incorrect problems for a user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) Authenticated user can create wrong answers under their profile.
     * @allow (get) Authenticated user can retrieve a wrong answer under their profile.
     * @allow (list) Authenticated user can list their own wrong answers.
     * @allow (update) Authenticated user can update wrong answers under their profile.
     * @allow (delete) Authenticated user can delete wrong answers under their profile.
     * @deny (create) Users cannot create wrong answers for other users.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages countries created by users.
     * @path /countries/{countryId}
     * @allow (get) Any authenticated user can read countries.
     * @allow (list) Any authenticated user can list countries.
     * @allow (create) Any authenticated user can create a country.
     * @deny (update) Only the creating user can update a country
     * @deny (delete) Countries cannot be deleted.
     * @principle Allows public read access but restricts write access to the creator.
     */
    match /countries/{countryId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tiles on the game map.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any authenticated user can read land tiles.
     * @allow (list) Any authenticated user can list land tiles.
     * @allow (create) Any authenticated user can create a land tile.
     * @allow (update) Any authenticated user can update a land tile.
     * @deny (delete) Land tiles cannot be deleted.
     * @principle Allows public read access and open write access for authenticated users.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    /**
     * @description Manages problem attempts for a user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get) Authenticated user can get problem attempts under their profile.
     * @allow (list) Authenticated user can list their own problem attempts.
     * @allow (create) Authenticated user can create problem attempts under their profile.
     * @deny (update) Problem attempts cannot be updated
     * @deny (delete) Problem attempts cannot be deleted.
     * @principle Enforces document ownership for all operations.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }
  }
}