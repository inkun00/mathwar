/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-specific data
 * while allowing public read access to certain game-related data. It prioritizes
 * security by ensuring that only authenticated users can access or modify data,
 * with strict validation of ownership and relational integrity. The rules are
 * designed to be flexible for prototyping, focusing on authorization and
 * minimizing schema enforcement.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Accessible only by the user themselves.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problems for a user. Accessible only by the user themselves.
 * - /countries/{countryId}: Stores country data. Publicly readable, but create/update restricted.
 * - /land_tiles/{landTileId}: Stores land tile data. Publicly readable, but write operations are disabled and should be handled by a Cloud Function.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's attempts at solving math problems. Accessible only by the user themselves.
 * - /join_requests/{requestId}: Requests from users to join a country.
 * - /alliance_requests/{requestId}: Requests from countries to form an alliance.
 *
 * Key Security Decisions:
 * - User listing is allowed.
 * - Land Tiles write operations are completely disabled in rules and should be handled via Cloud Functions.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 * - The `LandTile` entity requires the `ownerId` field. Rules enforce that this field matches the authenticated user's UID for write operations (handled by Cloud Function).
 * - The `Country` entity requires the `createdBy` field. Rules enforce that this field matches the authenticated user's UID for write operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list) if request.auth != null && request.auth.uid == userId
     * @allow (create) if request.auth != null && request.auth.uid == userId
     * @allow (update) if request.auth != null && request.auth.uid == userId
     * @deny (create) if request.auth == null
     * @deny (update) if request.auth == null
     * @principle Enforces user-ownership; only the authenticated user can read/write their own profile.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's wrong answer records.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get, list, create) if request.auth != null && request.auth.uid == userId
     * @allow (update, delete) if request.auth != null && request.auth.uid == userId
     * @deny (create) if request.auth == null
     * @deny (update, delete) if request.auth == null
     * @principle Enforces user-ownership; only the authenticated user can read/write their own incorrect answers.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to country records.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if request.auth != null
     * @allow (update) if request.auth != null && resource != null && request.auth.uid == resource.data.createdBy
     * @deny (create) if request.auth == null
     * @deny (update) if request.auth == null
     * @principle Allows public read access but restricts writes to authenticated users, create the country only if the `createdBy` matches the authenticated user's id, and restricts the update to only the creator of the country.
     */
    match /countries/{countryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource != null && request.auth.uid == resource.data.createdBy;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile records.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) if request.auth != null
     * @deny (create, update, delete) Always deny writes. Land Tiles writes should be handled by a Cloud Function.
     * @principle Allows public read access to authenticated users but disables writes.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) if request.auth != null && request.auth.uid == userId
     * @deny (create) if request.auth == null
     * @principle Enforces user-ownership; only the authenticated user can read/write their own problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to join requests.
     * @path /join_requests/{requestId}
     * @allow (get, list, create, update) if request.auth != null
     * @deny (create) if request.auth == null
     */
    match /join_requests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Controls access to alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (get, list, create, update) if request.auth != null
     * @deny (create) if request.auth == null
     */
    match /alliance_requests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
  }
}