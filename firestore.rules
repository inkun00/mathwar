/**
 * @fileoverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansions,
 * while also allowing public read access to countries, land tiles, and problems.
 * It prioritizes authorization independence through data denormalization.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the user can read or write their own profile.
 * - /countries/{countryId}: Stores country data. Publicly readable, but only the creating user can modify.
 * - /land_tiles/{landTileId}: Stores land tile data. Publicly readable, and only the owner can modify.
 * - /problems/{problemId}: Stores math problems. Publicly readable.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansion events for each user. Only the user can manage their own events.
 *
 * Key Security Decisions:
 * - Public read access is granted to the countries, land_tiles, and problems collections.
 * - User listing is not allowed for security and privacy reasons.
 * - All write operations require user authentication.
 * - Strict ownership is enforced for user profiles and territory expansions.
 *
 * Denormalization for Authorization:
 * - LandTile documents include the `ownerId`, allowing security rules to validate ownership without needing to `get()` the user document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces that only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - User 'test_user' with UID 'test_user' can create their profile.
     * @allow (update) - User 'test_user' with UID 'test_user' can update their profile.
     * @allow (get) - User 'test_user' with UID 'test_user' can read their profile.
     * @deny (create) - User 'other_user' with UID 'other_user' cannot create a profile for 'test_user'.
     * @deny (update) - User 'other_user' with UID 'other_user' cannot update the profile for 'test_user'.
     * @deny (delete) - User 'other_user' with UID 'other_user' cannot delete the profile for 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to read countries, but only the creator can modify them.
     * @path /countries/{countryId}
     * @allow (get) - Any authenticated user can read country data.
     * @allow (list) - Any authenticated user can list countries.
     * @allow (create) - User 'test_user' with UID 'test_user' can create a country.
     * @deny (update) - User 'other_user' with UID 'other_user' cannot update a country created by 'test_user'.
     * @deny (delete) - User 'other_user' with UID 'other_user' cannot delete a country created by 'test_user'.
     * @principle Enforces creator-based ownership for writes.
     */
    match /countries/{countryId} {
      function isCreator(userId) {
        return resource.data.createdBy == userId;
      }

       function isExistingCreator(userId) {
        return isCreator(userId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingCreator(request.auth.uid);
      allow delete: if isExistingCreator(request.auth.uid);
    }

    /**
     * @description Allows any user to read land tiles, but only the owner can modify them.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any authenticated user can read land tile data.
     * @allow (list) - Any authenticated user can list land tiles.
     * @allow (update) - User 'test_user' with UID 'test_user' can update their land tile.
     * @deny (update) - User 'other_user' with UID 'other_user' cannot update a land tile owned by 'test_user'.
     * @deny (delete) - User 'other_user' with UID 'other_user' cannot delete a land tile owned by 'test_user'.
     * @principle Enforces document ownership for writes on land tiles.
     */
    match /land_tiles/{landTileId} {
      function isOwner(ownerId) {
        return resource.data.ownerId == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(request.auth.uid);
      allow delete: if isExistingOwner(request.auth.uid);
    }

    /**
     * @description Allows any user to read math problems.
     * @path /problems/{problemId}
     * @allow (get) - Any user can read a math problem.
     * @allow (list) - Any user can list math problems.
     * @deny (create) - No user can create a math problem.
     * @deny (update) - No user can update a math problem.
     * @deny (delete) - No user can delete a math problem.
     * @principle Math problems are read-only for all users.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces that only the authenticated user can read and write their own territory expansion events.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - User 'test_user' with UID 'test_user' can create a territory expansion event.
     * @allow (update) - User 'test_user' with UID 'test_user' can update their territory expansion event.
     * @allow (get) - User 'test_user' with UID 'test_user' can read their territory expansion event.
     * @deny (create) - User 'other_user' with UID 'other_user' cannot create a territory expansion event for 'test_user'.
     * @deny (update) - User 'other_user' with UID 'other_user' cannot update the territory expansion event for 'test_user'.
     * @deny (delete) - User 'other_user' with UID 'other_user' cannot delete the territory expansion event for 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}