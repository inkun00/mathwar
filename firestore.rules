/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy: This ruleset employs a user-centric security model.
 *  - Users have full control over their own data and can only access or modify other users' data with specific authorization.
 *  - Rules are designed to prevent unauthorized data access and manipulation.
 *
 * Data Structure:
 *  - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 *  - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores user-specific incorrect answers. Only the user can access this data.
 *  - /countries/{countryId}: Stores country information, creatable by any authenticated user, but updatable only by the creator.
 *  - /land_tiles/{landTileId}: Stores game map tile information, creatable and updatable by authenticated users based on ownership.
 *  - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's problem attempts, only accessible to the user.
 *
 * Key Security Decisions:
 *  - User listing is allowed for game state purposes, but access to user details is restricted to the owner.
 *  - Countries and LandTiles are publicly readable to facilitate gameplay, but ownership is enforced for updates and deletes.
 *  - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:  The rules do not require any data denormalization. They rely on the `request.auth.uid` to control access to the corresponding `/users/{userId}` path.
 * Structural Segregation: The rules appropriately segregate private user data (e.g., wrong answers) into user subcollections and game data (e.g., countries, land tiles) into top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (create) if request.auth.uid == userId
     * @allow (update) if isOwner(userId)
     * @deny (delete) Always deny user deletion
     * @principle Enforces document ownership and prevents unauthorized modifications to user profiles.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's incorrect math problems.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if isOwner(userId)
     * @deny  operations if not owner.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow list, get, create, update, delete: if isOwner(userId);
    }

    /**
     * @description Controls access to countries created by users.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @allow (update) if resource.data.createdBy == request.auth.uid && resource != null;
     * @deny (delete) if true
     * @principle Allows public read access but restricts creation and updates to authenticated users and owners.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.createdBy);
      allow delete: if false;
    }

     /**
      * @description Controls access to land tiles on the game map.
      * @path /land_tiles/{landTileId}
      * @allow (get, list) if true
      * @allow (create) if isSignedIn();
      * @allow (update) if isSignedIn() && resource != null;
      * @deny (delete) Always deny land tile deletion.
      * @principle Allows public read access but restricts creation and updates to authenticated users.
      */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's problem attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if isOwner(userId)
     * @deny (update, delete) Always deny updates or deletes
     * @principle Restricts access to a user's own problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow list, get, create: if isOwner(userId);
      allow update, delete: if false;
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource, and the resource exists.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner and resource exists, false otherwise.
     */
     function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}