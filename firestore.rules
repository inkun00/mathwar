rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read the full list of users for leaderboards, etc.
    // They can only update their own document.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow update: if request.auth.uid == userId;
    }

    // Anyone can read the list of countries for the sign-up page.
    // Logged-in users can create new countries.
    // Logged-in users can update a country to mark it as 'demised'.
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 'demised' in request.resource.data && request.resource.data.demised == true;
    }

    // Logged-in users can create and update any land tile.
    match /land_tiles/{landTileId} {
      allow read, create, update: if request.auth != null;
    }

    // Users can read and create their own problem attempts.
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow read, create: if request.auth.uid == userId;
    }

    // Users can manage their own wrong answers.
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow read, create, delete: if request.auth.uid == userId;
    }
  }
}