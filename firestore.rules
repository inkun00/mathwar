/**
 * @fileoverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansions,
 * and public read access for countries, land tiles, and problems.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /countries/{countryId}: Stores countries, publicly readable, owner-writable.
 * - /land_tiles/{landTileId}: Stores land tiles, publicly readable, owner-writable.
 * - /problems/{problemId}: Stores problems, publicly readable, no writes allowed.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansions, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed by the rules structure.
 * - Public read access is granted for countries, land tiles, and problems to enable game functionality.
 * - Write access to countries and land tiles is restricted to the owner.
 * - Timestamps are not validated in this prototyping phase.
 *
 * Denormalization for Authorization:
 * - LandTile documents include the `ownerId`, so security rules can validate ownership without needing to `get()` the user document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces document ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile at /users/user_abc.
     * @allow (get, update, delete) - User with UID 'user_abc' can read/update/delete their profile at /users/user_abc.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read/update/delete the profile at /users/user_abc.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access and owner-only writes for countries.
     * @path /countries/{countryId}
     * @allow (get, list) - Any authenticated user can read any country.
     * @allow (create) - User with UID 'user_abc' can create a country with createdBy: 'user_abc'.
     * @allow (update, delete) - User with UID 'user_abc' can update/delete a country where resource.data.createdBy == 'user_abc'.
     * @deny (create) - User with UID 'user_xyz' cannot create a country with createdBy: 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update/delete a country where resource.data.createdBy == 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource.data != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.createdBy);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.createdBy);
    }

    /**
     * @description Allows public read access and owner-only writes for land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any authenticated user can read any land tile.
     * @allow (create) - User with UID 'user_abc' can create a land tile with ownerId: 'user_abc'.
     * @allow (update, delete) - User with UID 'user_abc' can update/delete a land tile where resource.data.ownerId == 'user_abc'.
     * @deny (create) - User with UID 'user_xyz' cannot create a land tile with ownerId: 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update/delete a land tile where resource.data.ownerId == 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource.data != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Allows public read access and no writes for problems.
     * @path /problems/{problemId}
     * @allow (get, list) - Any authenticated user can read any problem.
     * @deny (create, update, delete) - No user can create, update, or delete any problem.
     * @principle Restricts write access to a read-only collection.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces document ownership for territory expansions.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - User with UID 'user_abc' can create a territory expansion under their profile.
     * @allow (get, update, delete) - User with UID 'user_abc' can read/update/delete their territory expansion.
     * @deny (create) - User with UID 'user_xyz' cannot create a territory expansion under 'user_abc's profile.
     * @deny (get, update, delete) - User with UID 'user_xyz' cannot read/update/delete territory expansion under 'user_abc's profile.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }
}