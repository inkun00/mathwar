/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with role-based access control for certain shared resources.
 * Users have complete control over their own data (profile, attempts, wrong answers), while certain game-related
 * data (countries, land tiles) are broadly readable.  Write access to these shared resources is restricted.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: User's incorrect problem attempts.
 * - /countries/{countryId}: Countries created by users.
 * - /land_tiles/{landTileId}: Land tiles on the game map.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Attempts that user did on a problem
 *
 * Key Security Decisions:
 * - User listing is denied.
 * - Owner-only access is enforced for user profiles and associated data.
 * - Public read access is granted to countries and land tiles.
 *
 * Denormalization for Authorization:
 *  - The rules rely on the `request.auth.uid` to establish ownership. The `userId` parameter in the path
 *    is matched against the authenticated user's `uid` to authorize operations.  There are no explicit `get()`
 *    calls to other documents for authorization. The data model is structured to make the path the source of truth.
 *
 * Structural Segregation:
 *  - User-specific data (profile, attempts, wrong answers) is stored under the `/users/{userId}` collection,
 *    allowing for easy enforcement of owner-only access. Public data (countries, land tiles) is stored in top-level
 *    collections, enabling public read access while maintaining control over writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to the 'users' collection. Users can only read their own profile data.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, update) if the user is the owner (auth.uid === userId).
     * @deny (create, delete, list) all operations.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if false; // User documents are created via authentication triggers.
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages wrong answer records for users, restricting access to the owner of the record.
     * @path /databases/{database}/documents/users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get, list, create, update, delete) if the user is the owner (auth.uid === userId).
     * @deny Non-owners cannot access or modify another user's wrong answers.
     * @principle Enforces owner-only access to user-specific data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isExistingOwner(userId);
        allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages countries created by users, allowing public read access and restricted write access.
     * @path /databases/{database}/documents/countries/{countryId}
     * @allow (get, list) all operations.
     * @allow (create) if the 'createdBy' field matches the authenticated user's UID.
     * @deny (update, delete) all operations.
     * @principle Allows public read access while restricting write access to authorized users.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tiles on the game map, allowing public read access and restricted write access.
     * @path /databases/{database}/documents/land_tiles/{landTileId}
     * @allow (get, list) all operations.
     * @allow (create, update) if the user is authenticated.
     * @deny (delete) all operations.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }
    /**
     * @description Stores user problem attempts, allowing only the owner to read and create.
     * @path /databases/{database}/documents/problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) if the user is the owner (auth.uid === userId).
     * @deny (update, delete) all operations.
     * @principle Enforces owner-only access to user-specific data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(userId) {
          return request.auth.uid == userId;
        }

        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if false;
        allow delete: if false;
    }
  }
}