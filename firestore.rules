rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile at /users/user123.
     * @allow (get, list, update) - User with UID 'user123' can get, list, and update their own profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, list, update) - User with UID 'user456' cannot get, list, or update the profile at /users/user123.
     * @principle Enforces user-ownership; only the user can read/write their own data.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Controls access to wrong answer documents for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create, get, list, update, delete) - User with UID 'user123' can manage wrong answers under /users/user123/wrong_answers/.
     * @deny (create, get, list, update, delete) - User with UID 'user456' cannot manage wrong answers under /users/user123/wrong_answers/.
     * @principle Enforces user-ownership; only the user can manage their own wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to country documents.
     * @path /countries/{countryId}
     * @allow (get, list) - Any authenticated user can read country data.
     * @allow (create) - Any authenticated user can create a country. The 'createdBy' field must match the user's UID.
     * @allow (update) - Only the creator of the country can update it.
     * @deny (create) - Unauthenticated users cannot create countries.
     * @deny (update, delete) - Users who are not the creator cannot update or delete countries.
     * @principle Public read access with owner-only writes.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.createdBy;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any authenticated user can read land tile data.
     * @allow (create) - Any authenticated user can create a land tile. The 'ownerId' field must match the user's UID.
     * @allow (update) - Only the owner of the land tile can update it.
     * @deny (create) - Unauthenticated users cannot create land tiles.
     * @deny (update, delete) - Users who are not the owner cannot update or delete land tiles.
     * @principle Public read access with owner-only writes.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempt documents for a specific user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create, get, list) - User with UID 'user123' can create, get, and list attempts under /problem_attempts/user123/attempts/.
     * @deny (create, get, list) - User with UID 'user456' cannot manage attempts under /problem_attempts/user123/attempts/.
     * @principle Enforces user-ownership; only the user can create and list their own attempt data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow list, get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if false;
      allow delete: if false;
    }
  }
}