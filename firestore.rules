rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (update) if isOwner(userId)
     * @deny (create, delete) if true
     * @principle Enforces user-ownership for profile updates and prevents unauthorized creation/deletion.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages wrong answers for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if isOwner(userId)
     * @deny none
     * @principle Enforces user-ownership for accessing their own wrong answers.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isSignedIn() {
            return request.auth != null;
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }

    /**
     * @description Manages country data.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @deny (update, delete) if true
     * @principle Allows public read access but restricts creation to authenticated users and prevents unauthorized updates/deletions.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) if true
     * @allow (create, update) if isSignedIn()
     * @deny (delete) if true
     * @principle Allows public read access, and only authenticated users to create and update land tiles.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages problem attempts for analytics.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) if isOwner(userId)
     * @allow (list) if false;
     * @deny (get, update, delete) if true
     * @principle Enforces that only a user can create their own problem attempts, no listing and no updates/deletes.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isSignedIn() {
            return request.auth != null;
        }

        allow create: if isOwner(userId);
        allow get: if false;
        allow list: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}