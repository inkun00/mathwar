/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model. Each user has full
 * control over their own profile data and associated resources (e.g., wrong answers,
 * problem attempts). Countries and LandTiles are broadly readable, but ownership
 * is enforced for modifications.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, owned by the user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: User's incorrect problem attempts.
 * - /countries/{countryId}: Country data, created by a user, broadly readable.
 * - /land_tiles/{landTileId}: Land tile data, broadly readable.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores data about each problem attempt.
 *
 * Key Security Decisions:
 * - Users can only modify their own profiles and associated data.
 * - Countries and LandTiles are publicly readable to facilitate gameplay, but
 *   creation and modification are restricted.
 * - Listing of all users is disallowed for privacy.
 *
 * Denormalization for Authorization:
 *  - The `LandTile` and `Country` entities both lack an ownership field such as `authorId` or `ownerId`,
 *  which makes implementing owner-only writes impossible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read any user profile.
     * @allow (update) Authenticated user can update their own profile.
     * @deny (create) User cannot create a profile directly.
     * @deny (delete) User cannot delete their profile.
     * @deny (list) Listing all users is not permitted.
     * @principle Enforces document ownership for updates and restricts listing of user data.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if false;

    }

    /**
     * @description Controls access to a user's incorrect problem attempts.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) Authenticated user can create a wrong answer under their own user ID.
     * @allow (get) Authenticated user can read a wrong answer under their own user ID.
     * @allow (update) Authenticated user can update a wrong answer under their own user ID.
     * @allow (delete) Authenticated user can delete a wrong answer under their own user ID.
     * @allow (list) Authenticated user can list their own wrong answers.
     * @deny All operations for other users.
     * @principle Restricts access to a user's own data tree and validates relational integrity.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to country data.
     * @path /countries/{countryId}
     * @allow (get) Any authenticated user can read country data.
     * @allow (list) Any authenticated user can list countries.
     * @allow (create) Any authenticated user can create a country.
     * @deny (update) Updating a country is not permitted.
     * @deny (delete) Deleting a country is not permitted.
     */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any authenticated user can read land tile data.
     * @allow (list) Any authenticated user can list land tiles.
     * @allow (create) Any authenticated user can create a land tile.
     * @allow (update) Any authenticated user can update a land tile.
     * @deny (delete) Deleting a land tile is not permitted.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts for a specific user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) Authenticated user can create problem attempts under their own user ID.
     * @allow (get) Authenticated user can read problem attempts under their own user ID.
     * @allow (list) Authenticated user can list their own problem attempts.
     * @deny All operations for other users.
     * @principle Restricts access to a user's own data and enforces data integrity.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if false;
        allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}