rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read all user/country/land data for game state.
    // Writes are more restrictive.
    
    // /users/{userId}
    // - Anyone can read user profiles for leaderboards, map display, etc.
    // - A user can ONLY update their own profile.
    // - HOWEVER, any authenticated user can update another user's 'tokens' and 'conqueredCountries' fields for game logic.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      
      // Allow a user to update their own document for standard changes.
      allow update: if request.auth.uid == userId;
      
      // Also allow updates ONLY to 'tokens' or 'conqueredCountries' fields by any authenticated user for game logic
      // e.g., an attacker updating their conquered list, or the system compensating a player for lost territory.
      allow update: if request.auth != null && 
                      (request.resource.data.keys().hasOnly(['tokens']) || 
                       request.resource.data.keys().hasOnly(['conqueredCountries']));
    }
    
    // /countries/{countryId}
    // - Anyone can read country data.
    // - A user can create a new country.
    // - Any authenticated user can update a country's 'demised' status.
    match /countries/{countryId} {
      allow get, list, create: if request.auth != null;
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['demised']);
    }

    // /land_tiles/{landTileId}
    // - Anyone can read tile data.
    // - Anyone can create new tiles (claim neutral territory).
    // - Anyone can update tiles (conquering).
    match /land_tiles/{landTileId} {
      allow get, list, create, update: if request.auth != null;
    }

    // /problem_attempts/{userId}/attempts/{attemptId}
    // - A user can only create and read their own problem attempts.
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get, list, create: if request.auth.uid == userId;
    }

    // /users/{userId}/wrong_answers/{wrongAnswerId}
    // - A user can fully manage their own wrong answers list.
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        allow read, write, delete: if request.auth.uid == userId;
    }
  }
}
