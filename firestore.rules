/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model.  Users can only
 * read and write their own data, with some exceptions for public game data.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /countries/{countryId}: Countries created by users, publicly readable, but creation is restricted.
 * - /land_tiles/{landTileId}: Land tiles on the map, publicly readable, but creation and updates are restricted.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problem attempts for user.
 * - /problem_attempts/{userId}/attempts/{attemptId}: User problem solving attempts for analytics.
 *
 * Key Security Decisions:
 * - Users collection is NOT listable. This prevents enumeration of all users.
 *
 * Denormalization for Authorization:
 * - The `ownerId` field is used in LandTile documents to determine ownership.
 * - The `createdBy` field is used in Country documents to track the user who created the country.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to user profiles.
     * @path: /users/{userId}
     * @allow: (get) Authenticated user can read their own profile.
     * @allow: (update) Authenticated user can update their own profile.
     * @deny: (get) Authenticated user cannot read another user's profile.
     * @deny: (update) Authenticated user cannot update another user's profile.
     * @deny: (list) No one can list all user profiles.
     * @principle: Enforces user ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description: Manages countries created by users.
     * @path: /countries/{countryId}
     * @allow: (get, list) Any authenticated user can read country data.
     * @allow: (create) Any authenticated user can create a new country. The 'createdBy' field must match the user's UID.
     * @deny: (update, delete) Only the creator can update/delete a country.
     * @principle: Allows public read access with owner-only writes for countries.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.get('createdBy') == request.auth.uid;
      allow update, delete: if false; // TODO: Implement owner-only writes after data model is clarified.
    }

    /**
     * @description: Manages land tiles on the game map.
     * @path: /land_tiles/{landTileId}
     * @allow: (get, list) Any authenticated user can read land tile data.
     * @allow: (create, update) Only the owner can create/update the land tile. The `ownerId` field must match the user's UID.
     * @deny: (delete) No one can delete a land tile.
     * @principle: Allows public read access with owner-only writes for land tiles.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.get('ownerId') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('ownerId') == request.auth.uid; // Verifies resource exists.
      allow delete: if false;
    }

    /**
     * @description: Manages wrong answer attempts for a user.
     * @path: /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow: (get, list) Only the owner can list and get wrong answers.
     * @allow: (create, update, delete) Only the owner can create, update and delete wrong answers.
     * @principle: Enforces user ownership for wrong answer data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

       /**
        * @description: Manages problem attempts for a user.
        * @path: /problem_attempts/{userId}/attempts/{attemptId}
        * @allow: (get, list) Only the owner can list and get problem attempts.
        * @allow: (create) Only the owner can create problem attempts.
        * @deny: (update, delete) No one can update or delete problem attempts.
        * @principle: Enforces user ownership for problem attempts data.
        */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}