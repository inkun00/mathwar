rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Denies access to the `map_aggregates` collection due to unspecified access control.
     * @path /databases/{database}/documents/map_aggregates
     * @allow (get, list, create, update, delete) - N/A: Access is denied.
     * @deny (get, list, create, update, delete) - Any operation.
     * @principle Explicitly deny access when no access control is specified.
     */
    match /map_aggregates/{document} {
        allow get: if false;
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Manages user profiles. Users can read their own profile, create their profile, and update their own profile.
     * @path /users/{userId}
     * @allow (get) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can read /users/nZdE0ay5wERDLPHasKVzIRa6aWk2.
     * @allow (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can create /users/nZdE0ay5wERDLPHasKVzIRa6aWk2 if request.resource.data.id == "nZdE0ay5wERDLPHasKVzIRa6aWk2".
     * @allow (update) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can update /users/nZdE0ay5wERDLPHasKVzIRa6aWk2.
     * @deny (get) User anotherUser can't read /users/nZdE0ay5wERDLPHasKVzIRa6aWk2.
     * @deny (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can't create /users/anotherUserId.
     * @deny (update) User anotherUser can't update /users/nZdE0ay5wERDLPHasKVzIRa6aWk2.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSelfCreate(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId); // Only owner can delete

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      function isSelfCreate(userId) {
        return request.auth.uid == userId;
      }
    }

    /**
     * @description Manages wrong answers for a specific user. Only the user can access their own wrong answers.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can list /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers.
     * @allow (get) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can get /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @allow (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can create /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @allow (update) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can update /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @allow (delete) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can delete /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @deny (list) User anotherUser can't list /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers.
     * @deny (get) User anotherUser can't get /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @deny (create) User anotherUser can't create /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @deny (update) User anotherUser can't update /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @deny (delete) User anotherUser can't delete /users/nZdE0ay5wERDLPHasKVzIRa6aWk2/wrong_answers/someWrongAnswerId.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

     /**
      * @description Manages countries created by users. All authenticated users can read countries.
      * @path /countries/{countryId}
      * @allow (get, list) Any authenticated user can read any country.
      * @allow (create) Any authenticated user can create a country.
      * @allow (update) Any authenticated user can update a country.
      * @deny (create) Unauthenticated user can't create a country.
      * @principle Allows public reads, enforces authentication for writes.
      */
    match /countries/{countryId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;

    }

    /**
     * @description Manages land tiles on the game map. All authenticated users can read land tiles.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any authenticated user can read any land tile.
     * @allow (create) Any authenticated user can create a land tile.
     * @allow (update) Any authenticated user can update a land tile.
     * @deny (create) Unauthenticated user can't create a land tile.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /land_tiles/{landTileId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;

    }

    /**
     * @description Manages problem attempts for a specific user. Only the user can create and list their own attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can list /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts.
     * @allow (get) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can get /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts/someAttemptId.
     * @allow (create) User nZdE0ay5wERDLPHasKVzIRa6aWk2 can create /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts/someAttemptId.
     * @deny (list) User anotherUser can't list /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts.
     * @deny (get) User anotherUser can't get /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts/someAttemptId.
     * @deny (create) User anotherUser can't create /problem_attempts/nZdE0ay5wERDLPHasKVzIRa6aWk2/attempts/someAttemptId.
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
    function isSignedIn() {
        return request.auth != null;
      }

    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    function isSelfCreate(userId) {
        return request.auth.uid == userId;
    }
}