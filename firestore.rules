rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can list countries, but only logged-in users can create.
    // Specific fields of a country can be updated by logged-in users.
    match /countries/{countryId} {
      allow list, get: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['demised']);
    }

    // Logged-in users can list all users.
    // Users can create their own user document.
    // Users can update their own document, or specific fields ('tokens', 'conqueredCountries') on other users' documents.
    match /users/{userId} {
      allow list, get: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
                      request.auth.uid == userId ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'conqueredCountries'])
                    );
    }
    
    // Logged-in users can perform any action on land tiles.
    match /land_tiles/{tileId} {
      allow read, write: if request.auth != null;
    }
    
    // Users can only read and create attempts within their own subcollection.
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only manage wrong answers within their own subcollection.
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
