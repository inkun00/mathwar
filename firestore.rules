/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model where users primarily have access to their own data.
 * Additionally, there are public read collections for game-related data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible to the owner for updates and readable by all authenticated users.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect problem attempts, only accessible by the owning user.
 * - /countries/{countryId}: Stores country data, publicly readable, but restricted to authenticated users for creation.
 * - /land_tiles/{landTileId}: Stores land tile data, publicly readable, and restricted to authenticated users for create and update.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempts for a user. Only the user can create and list their own attempts.
 *
 * Key Security Decisions:
 * - Users can only modify their own profiles.
 * - Data validation is relaxed in this prototyping phase, focusing on ownership and relational integrity.
 * - List operations on user-specific data are restricted to the owning user.
 *
 * Denormalization for Authorization:
 *  - User ownership is enforced via the `userId` parameter in the path for user-specific data, avoiding the need for `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (get, list) if isSignedIn()
     * @allow (update) if isSignedIn() && isOwner(userId)
     * @deny (create) if true
     * @deny (delete) if true
     * @principle Enforces user-ownership and authenticated access for profile management.
     */
    match /users/{userId} {
      // Anyone who is signed in can read user profiles
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages wrong answer records for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get, create, update, delete) if isSignedIn() && isOwner(userId)
     * @deny (operations) if !isSignedIn() || !isOwner(userId)
     * @principle Restricts access to a user's own wrong answer records.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow list, get, create, update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Manages country data, allowing public read access and authenticated create access.
     * @path /countries/{countryId}
     * @allow (get, list) if true
     * @allow (create) if isSignedIn()
     * @deny (update, delete) if true
     * @principle Provides public read access while restricting modifications.
     */
    match /countries/{countryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tile data, allowing public read access and authenticated create/update access.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) if true
     * @allow (create, update) if isSignedIn()
     * @deny (delete) if true
     * @principle Provides public read access while restricting modifications.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages user problem attempts for analytics.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get, create) if isSignedIn() && isOwner(userId)
     * @deny (update, delete) if true
     * @principle Restricts access to a user's own problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      allow list, get, create: if isSignedIn() && isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId - The user ID to check against the request's auth UID.
     * @return {boolean} True if the request is made by the owner.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}