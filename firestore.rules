rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get) User with ID 'user123' can read their profile.
     * @allow (update) User with ID 'user123' can update their profile.
     * @allow (delete) User with ID 'user123' can delete their profile.
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to country documents.
     * @path /countries/{countryId}
     * @allow (get) Any signed-in user can read a country document.
     * @allow (list) Any signed-in user can list country documents.
     * @allow (create) Any signed-in user can create a country document.
     * @allow (update) Any signed-in user can update a country document.
     * @allow (delete) Any signed-in user can delete a country document.
     * @deny (create) Non-signed-in user cannot create a country document.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (get) Any user can read a land tile document.
     * @allow (list) Any user can list land tile documents.
     * @deny (create) No one can create a land tile document (creation should be done via backend).
     * @deny (update) No one can update a land tile document.
     * @deny (delete) No one can delete a land tile document.
     * @principle Publicly readable, writes disabled.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to problem documents.
     * @path /problems/{problemId}
     * @allow (get) Any user can read a problem document.
     * @allow (list) Any user can list problem documents.
     * @deny (create) No one can create a problem document (creation should be done via backend).
     * @deny (update) No one can update a problem document.
     * @deny (delete) No one can delete a problem document.
     * @principle Publicly readable, writes disabled.
     */
    match /problems/{problemId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to territory expansion documents for a specific user.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) User with ID 'user123' can create a territory expansion record under their profile.
     * @allow (get) User with ID 'user123' can read their territory expansion record.
     * @allow (update) User with ID 'user123' can update their territory expansion record.
     * @allow (delete) User with ID 'user123' can delete their territory expansion record.
     * @deny (create) User with ID 'user123' cannot create a territory expansion record for 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}