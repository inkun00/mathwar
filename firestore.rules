/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and land tiles,
 * and allows open reads for countries.  Problem attempts are stored in a nested
 * collection under each user and are only accessible by that user.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Only the user can modify their profile.
 * - /countries/{countryId}: Stores country information. Accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Stores land tile information. Only the owner can modify a land tile.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempts made by users. Only the associated user can access these attempts.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Countries are publicly readable. Only authenticated users can create countries.
 * - Land Tiles are publicly readable. Only the owner can modify them.
 * - Problem attempts are private to each user.
 *
 * Denormalization for Authorization:
 * - LandTile documents include an `ownerId` field, which is used to quickly verify ownership without needing to perform additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Only the user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' creates a profile with id 'user123'.
     * @allow (get) - User with UID 'user123' reads their profile.
     * @allow (update) - User with UID 'user123' updates their profile.
     * @allow (delete) - User with UID 'user123' deletes their profile.
     * @deny (create) - User with UID 'user456' attempts to create a profile with id 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update the profile of user 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete the profile of user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages countries.  Countries are publicly readable, but only authenticated users can create them.
     * @path /countries/{countryId}
     * @allow (get) - Any user can read a country.
     * @allow (list) - Any user can list countries.
     * @allow (create) - Authenticated user creates a new country.
     * @deny (update) - Unauthenticated user attempts to update a country.
     * @deny (delete) - Unauthenticated user attempts to delete a country.
     * @principle Allows open reads while restricting writes to authenticated users.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages land tiles. Land tiles are publicly readable, but only the owner can modify them.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any user can read a land tile.
     * @allow (list) - Any user can list land tiles.
     * @allow (create) - User with UID 'user123' creates a land tile with ownerId 'user123'.
     * @deny (create) - User with UID 'user456' attempts to create a land tile with ownerId 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update a land tile owned by 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete a land tile owned by 'user123'.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Stores problem attempts made by each user, accessible only by that user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) - User with UID 'user123' creates a problem attempt under their ID.
     * @allow (get) - User with UID 'user123' reads a problem attempt under their ID.
     * @allow (update) - User with UID 'user123' updates a problem attempt under their ID.
     * @allow (delete) - User with UID 'user123' deletes a problem attempt under their ID.
     * @deny (create) - User with UID 'user456' attempts to create a problem attempt under user 'user123'.
     * @deny (update) - User with UID 'user456' attempts to update a problem attempt belonging to user 'user123'.
     * @deny (delete) - User with UID 'user456' attempts to delete a problem attempt belonging to user 'user123'.
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
    }
  }
}