
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isUpdating(field) {
      return request.resource.data.keys().hasOnly([field]);
    }

    function isUpdatingMultiple(fields) {
      return request.resource.data.keys().hasAll(fields) && request.resource.data.keys().size() == fields.size();
    }

    match /users/{userId} {
      // Allow authenticated users to read any user profile for game state (e.g., leaderboard)
      allow get, list: if request.auth != null;
      
      // Allow users to update their own document,
      // OR allow any authenticated user to update ONLY the 'tokens' or 'conqueredCountries' fields of another user.
      // This is necessary for territory cut compensation and conquest tracking.
      allow update: if (request.auth.uid == userId && !isUpdating('tokens') && !isUpdating('conqueredCountries') && !isUpdatingMultiple(['tokens', 'conqueredCountries'])) || 
                    (request.auth != null && (isUpdating('tokens') || isUpdating('conqueredCountries') || isUpdatingMultiple(['tokens', 'conqueredCountries'])));
      
      // Users can only create their own profile
      allow create: if request.auth.uid == userId;

      match /wrong_answers/{wrongAnswerId} {
        // Only the user can manage their own wrong answers
        allow list, get, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /countries/{countryId} {
      // Allow ANY user (authenticated or not) to read country data.
      // This is required for the sign-up page where users select a country before they are fully logged in and have a profile.
      allow get, list: if true;

      // Allow authenticated users to create a new country
      allow create: if request.auth != null;

      // Allow any authenticated user to update a country, but ONLY to set 'demised' to true.
      // This prevents other malicious updates.
      allow update: if request.auth != null && request.resource.data.demised == true && isUpdating('demised');
    }

    match /land_tiles/{landTileId} {
      // Allow any authenticated user to read, create, and update land tiles for gameplay
      allow list, get, create, update: if request.auth != null;
    }

    match /problem_attempts/{userId}/{doc=**} {
        // Users can only create and read their own problem attempts
        allow list, get, create: if request.auth != null && request.auth.uid == userId;
    }
  }
}
