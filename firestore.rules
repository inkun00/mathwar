/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with role-based access control for certain game data.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible and modifiable only by the user themselves.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problems for review, only accessible by the user.
 * - /countries/{countryId}: Countries created by users, accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Land tiles on the game map, accessible to all authenticated users.
 * - /problem_attempts/{userId}/attempts/{attemptId}: User's problem solving attempts, accessible only by that user.
 *
 * Key Security Decisions:
 * - Users can only manage their own profiles and related data.
 * - Game data (countries, land tiles) is broadly accessible to authenticated users.
 * - Listing of all users is not permitted.
 *
 * Denormalization for Authorization:
 *  - The `LandTile` entity requires denormalization of the `ownerId` field to efficiently secure land tile ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get, list, update) - Authenticated user can get, list, and update their own profile.
     * @deny (create) - If the userId does not match the authenticated user's uid.
     * @deny (update) - If a different user attempts to update another user's profile.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.id == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Manages incorrect problem records for users.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) - Only the authenticated user can create wrong answer records under their UID.
     * @allow (get, list, update, delete) - Only the owner can manage their wrong answers.
     * @deny (create) - If the userId does not match the authenticated user's uid.
     * @deny (get, list, update, delete) - If a different user attempts to access another user's wrong answers.
     * @principle Restricts access to a user's own learning data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to country documents.
     * @path /countries/{countryId}
     * @allow (get, list) - All authenticated users can read country data.
     * @allow (create, update) - All authenticated users can create and update country data.
     * @deny (delete) - No user can delete a country.
     * @principle Allows open read access but restricts listing to authenticated users.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages access to land tile documents.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - All authenticated users can read land tile data.
     * @allow (create, update) - Any authenticated user can create and update land tiles.
     * @deny (delete) - No user can delete a land tile.
     * @principle Allows open access to land tile data for authenticated users.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages user's problem solving attempts.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) - Only the authenticated user can create attempt records under their UID.
     * @allow (get, list) - Only the owner can view their attempts.
     * @deny (update, delete) - Attempts cannot be updated or deleted.
     * @principle Restricts access to a user's own problem attempts.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

        /**
     * @description Denies listing of the map_aggregates collection.
     * @path /map_aggregates
     * @deny (list) - No user can list the map_aggregates collection.
     */
    match /map_aggregates {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}