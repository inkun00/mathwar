/**
 * @fileoverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and territory expansions,
 * and public read access for countries, land tiles, and problems.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the user can modify their profile.
 * - /countries/{countryId}: Stores countries created by users. Accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Stores land tiles on the game map. Accessible to all users.
 * - /problems/{problemId}: Stores math problems for the game. Accessible to all users.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores territory expansion events for each user.
 *   Only the user can modify their own expansion records.
 *
 * Key Security Decisions:
 * - Users can only manage their own profile and territory expansion records.
 * - Countries, land tiles, and problems are publicly readable.
 * - No listing of users is allowed.
 *
 * Denormalization for Authorization:
 * - LandTile documents include the `ownerId`, so security rules can validate ownership without needing to `get()` the user document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create a profile at /users/user_abc.
     * @allow (get) - User with UID 'user_abc' can read their profile at /users/user_abc.
     * @allow (update) - User with UID 'user_abc' can update their profile at /users/user_abc.
     * @allow (delete) - User with UID 'user_abc' can delete their profile at /users/user_abc.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get) - User with UID 'user_xyz' cannot read the profile at /users/user_abc.
     * @deny (update) - User with UID 'user_xyz' cannot update the profile at /users/user_abc.
     * @deny (delete) - User with UID 'user_xyz' cannot delete the profile at /users/user_abc.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to countries. All authenticated users can read countries. Only the creator can modify.
     * @path /countries/{countryId}
     * @allow (get) - Any authenticated user can read a country.
     * @allow (list) - Any authenticated user can list countries.
     * @allow (create) - User with UID 'user_abc' can create a country. request.resource.data.createdBy must equal 'user_abc'.
     * @allow (update) - User with UID 'user_abc' can update a country they created (resource.data.createdBy == 'user_abc').
     * @allow (delete) - User with UID 'user_abc' can delete a country they created (resource.data.createdBy == 'user_abc').
     * @deny (create) - User with UID 'user_xyz' cannot create a country with createdBy: 'user_abc'.
     * @deny (update) - User with UID 'user_xyz' cannot update a country created by 'user_abc'.
     * @deny (delete) - User with UID 'user_xyz' cannot delete a country created by 'user_abc'.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /countries/{countryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    /**
     * @description Controls access to land tiles. Land tiles are publicly readable, but only the owner can modify.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any user can read a land tile.
     * @allow (list) - Any user can list land tiles.
     * @allow (create) - User with UID 'user_abc' can create a land tile with ownerId: 'user_abc'.
     * @allow (update) - User with UID 'user_abc' can update a land tile they own (resource.data.ownerId == 'user_abc').
     * @allow (delete) - User with UID 'user_abc' can delete a land tile they own (resource.data.ownerId == 'user_abc').
     * @deny (create) - User with UID 'user_xyz' cannot create a land tile with ownerId: 'user_abc'.
     * @deny (update) - User with UID 'user_xyz' cannot update a land tile owned by 'user_abc'.
     * @deny (delete) - User with UID 'user_xyz' cannot delete a land tile owned by 'user_abc'.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /land_tiles/{landTileId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.ownerId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to problems. Problems are publicly readable.
     * @path /problems/{problemId}
     * @allow (get) - Any user can read a problem.
     * @allow (list) - Any user can list problems.
     * @allow (create) - User can create a problem.
     * @allow (update) - User can update a problem.
     * @allow (delete) - User can delete a problem.
     * @principle Allows public read access and open write access.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to territory expansion events for each user. Only the user can manage their own expansion records.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - User with UID 'user_abc' can create an expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @allow (get) - User with UID 'user_abc' can read their expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @allow (update) - User with UID 'user_abc' can update their expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @allow (delete) - User with UID 'user_abc' can delete their expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @deny (create) - User with UID 'user_xyz' cannot create an expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @deny (get) - User with UID 'user_xyz' cannot read the expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @deny (update) - User with UID 'user_xyz' cannot update the expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @deny (delete) - User with UID 'user_xyz' cannot delete the expansion event at /users/user_abc/territory_expansions/{territoryExpansionId}.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}