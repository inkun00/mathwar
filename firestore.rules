/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model where users have full control over their own data,
 * combined with public read access to certain collections like 'problems' and 'land_tiles'.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 * - /countries/{countryId}: Stores countries, accessible to all authenticated users.
 * - /land_tiles/{landTileId}: Stores land tiles, publicly readable but owner-writeable. Includes denormalized `ownerId`.
 * - /problems/{problemId}: Stores math problems, publicly readable.
 * - /users/{userId}/territory_expansions/{territoryExpansionId}: Stores user's territory expansion data, only accessible to the user.
 *
 * Key Security Decisions:
 * - Users can only read/write their own user document.
 * - Listing users is disallowed.
 * - Land tiles are publicly listable, but only the owner can modify them.
 * - Problems are publicly accessible.
 *
 * Denormalization for Authorization:
 * - The `land_tiles` collection includes the `ownerId` field directly in each document.
 *   This allows security rules to efficiently validate ownership without needing extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - User with ID 'user123' can get, update, or delete their profile if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get, update, delete) - User with ID 'user456' cannot get, update, or delete the profile with ID 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures countries. All authenticated users can read and create countries.
     * @path /countries/{countryId}
     * @allow (get, list, create) - Any authenticated user can read and create countries.
     * @deny (update, delete) - Only the owner should be able to update or delete countries (not yet implemented).
     * @principle Allows open reads and authenticated writes.
     */
    match /countries/{countryId} {
       allow get, list: if isSignedIn();
       allow create: if isSignedIn();
       allow update, delete: if false;  // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Secures land tiles. Land tiles are publicly readable, but only the owner can modify them.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any user can read all land tiles.
     * @allow (create) - Only the owner can create a land tile, and the ownerId must match the authenticated user.
     * @allow (update, delete) - Only the owner of the land tile can update or delete it.
     * @deny (create) - A user cannot create a land tile for another user.
     * @deny (update, delete) - A user cannot update or delete a land tile owned by another user.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /land_tiles/{landTileId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isOwner(request.resource.data.ownerId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Secures math problems. All users can read math problems. Write access is denied.
     * @path /problems/{problemId}
     * @allow (get, list) - Any user can read math problems.
     * @deny (create, update, delete) - No user can create, update, or delete math problems.
     * @principle Allows open reads, denies all writes.
     */
    match /problems/{problemId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secures territory expansion events for each user. Only the user can read/write their own expansion records.
     * @path /users/{userId}/territory_expansions/{territoryExpansionId}
     * @allow (create) - User with ID 'user123' can create a territory expansion record if request.auth.uid == 'user123'.
     * @allow (get, list, update, delete) - User with ID 'user123' can get, list, update, or delete their territory expansion records if request.auth.uid == 'user123'.
     * @deny (create) - User with ID 'user456' cannot create a territory expansion record for user 'user123'.
     * @deny (get, list, update, delete) - User with ID 'user456' cannot get, list, update, or delete territory expansion records for user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/territory_expansions/{territoryExpansionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}