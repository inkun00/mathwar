rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCountryOwner(countryId) {
      return get(/databases/$(database)/documents/countries/$(countryId)).data.createdBy == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow list: if true;
      allow get: if request.auth != null;
      allow create: if request.auth.uid == userId;
      // Only the user themselves can update their own document.
      allow update: if request.auth.uid == userId;
    }

    // Countries collection
    match /countries/{countryId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow country owner to update the flag, or any logged-in user to update 'demised' status.
      allow update: if request.auth != null && 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['demised']) ||
                        (isCountryOwner(countryId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag'])));
    }

    // Land tiles collection
    match /land_tiles/{landTileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Problem Attempts subcollection
    match /problem_attempts/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Wrong Answers subcollection
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Join Requests collection
    match /join_requests/{requestId} {
      // Logged-in users can create join requests.
      allow create: if request.auth != null;
      // Only the owner of the target country can read or update the request.
      allow read, update: if request.auth != null && isCountryOwner(resource.data.targetCountryId);
    }
    
    // Alliance Requests collection
    match /alliance_requests/{requestId} {
        // Only a country owner can create an alliance request.
        allow create: if request.auth != null && isCountryOwner(request.resource.data.requestingCountryId);
        // Only the owner of the target country can read or update it.
        allow read, update: if request.auth != null && isCountryOwner(resource.data.targetCountryId);
    }
  }
}
