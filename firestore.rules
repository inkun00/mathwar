/**
 * @fileOverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model with owner-only access to user-specific data
 * and public read access to shared game data. It prioritizes security by default, restricting
 * access unless explicitly allowed.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores incorrect math problems for a user.
 * - /countries/{countryId}: Stores countries created by users.
 * - /land_tiles/{landTileId}: Stores land tiles on the game map.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores each attempt a user makes on a problem for analytics
 *
 * Key Security Decisions:
 * - User profiles are readable by all authenticated users but only writable by the owner.
 * - The `wrong_answers` subcollection is strictly private to the owning user.
 * - Countries and land tiles are readable by all authenticated users, with create and update access restricted to authenticated users.
 * - Problem attempts can only be created and read by the owning user.
 *
 * Denormalization for Authorization:
 * The current data model includes the `createdBy` field on the `Country` entity, allowing
 * for owner-based authorization of country data. The `ownerId` field on `LandTile` is used to define
 * land tile ownership. The `userId` field exists on `problem_attempts` and `wrong_answers` to define ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (get, list): Any signed-in user can read user profiles.
     * @allow (create): A user can create their own profile if the userId matches their auth UID.
     * @allow (update): A user can update their own profile if the userId matches their auth UID.
     * @deny (create): A user cannot create a profile with an ID that does not match their auth UID.
     * @deny (update): A user cannot update another user's profile.
     * @principle Enforces user-ownership for profile management and allows open reads for other users
     */
    match /users/{userId} {
      // Allows any signed-in user to read user profiles
      allow get, list: if isSignedIn();

      // Allows a user to create their own profile if the userId matches their auth UID
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Allows a user to update their own profile if the userId matches their auth UID
      allow update: if isExistingOwner(userId);

      // Prevents deletion of user profiles
      allow delete: if false;

    }

    /**
     * @description Manages wrong answer entries for review by the owning user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get): The user can list and get their own wrong answers.
     * @allow (create): The user can create wrong answers under their own user ID.
     * @allow (update, delete): The user can update and delete their own wrong answers.
     * @deny (list, get): A user cannot list or get another user's wrong answers.
     * @deny (create, update, delete): A user cannot create, update, or delete wrong answers under another user's ID.
     * @principle Enforces strict user-ownership for private data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      // Allows the user to list and get their own wrong answers
      allow list, get: if isOwner(userId);

      // Allows the user to create wrong answers under their own user ID
      allow create: if isOwner(userId);

      // Allows the user to update and delete their own wrong answers
      allow update, delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages country access.
     * @path /countries/{countryId}
     * @allow (get, list): Any signed-in user can read country data.
     * @allow (create): Any signed-in user can create a country. The 'createdBy' field must match their auth UID.
     * @allow (update): Only the user who created the country can update it.
     * @deny (create): A user cannot create a country with a 'createdBy' field that doesn't match their auth UID.
     * @deny (update): A user cannot update a country they didn't create.
     * @principle Enforces owner-only write access with public reads
     */
    match /countries/{countryId} {
      // Allows any signed-in user to read country data
      allow get, list: if isSignedIn();

      // Allows a user to create a country, with creator validation
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;

      // Allows the country creator to update
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Prevents deletion of countries
      allow delete: if false;
    }

    /**
     * @description Manages land tile access.
     * @path /land_tiles/{landTileId}
     * @allow (get, list): Any signed-in user can read land tile data.
     * @allow (create): Any signed-in user can create land tile.
     * @allow (update): Only the owner of the land tile can update it.
     * @principle Enforces owner-only write access with public reads
     */
    match /land_tiles/{landTileId} {
      // Allows any signed-in user to read land tile data
      allow get, list: if isSignedIn();

      // Allows a user to create a land tile
      allow create: if isSignedIn();

      // Allows the owner to update land tile
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Prevents deletion of land tiles
      allow delete: if false;
    }

      /**
       * @description Stores each attempt a user makes on a problem for analytics.
       * @path /problem_attempts/{userId}/attempts/{attemptId}
       * @allow (list, get): The user can list and get their own attempts.
       * @allow (create): The user can create attempts under their own user ID.
       * @deny (create): A user cannot create an attempt with an ID that does not match their auth UID.
       * @deny (list, get): A user cannot list or get another user's attempts.
       * @deny (update, delete): Not allowed.
       * @principle Enforces strict user-ownership for problem attempt data.
       */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      // Allows the user to list and get their own attempts
      allow list, get: if isOwner(userId);

      // Allows the user to create attempts under their own user ID
      allow create: if isOwner(userId);

      // update and delete is not allowed
      allow update, delete: if false;
    }
  }

  // Helper function to determine if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Helper function to determine if the user is the owner of an existing document
  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }
}