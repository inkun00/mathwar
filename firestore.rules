/**
 * @file Firestore Security Rules for Decimal Conquest
 *
 * @core_philosophy This ruleset prioritizes user-level access control for most data,
 *  allowing users to read game data while ensuring only they can modify their own profiles and related data.
 *  Public read access is granted to game data, but writes are restricted to authorized users, and only when validating
 *  data consistency.
 *
 * @data_structure
 * - /users/{userId}: User profiles, accessible and modifiable only by the user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problem attempts, accessible only by the user.
 * - /countries/{countryId}: Country data, readable by all authenticated users, writable by creators.
 * - /land_tiles/{landTileId}: Land tile data, readable by all authenticated users, writable by owners.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Problem attempt history, accessible only by the user.
 *
 * @key_security_decisions
 * - User listing is allowed to support in-game interactions.
 * - Data validation is limited to relational integrity and ownership checks to enable rapid prototyping.
 * - Clear separation of user-specific data into subcollections for better security and scalability.
 *
 * @denormalization_for_authorization
 * - Countries and LandTiles require the `createdBy` and `ownerId` fields respectively for write authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile with matching userId.
     * @allow (get, list) - Any authenticated user can read user profiles.
     * @allow (update) - Only the authenticated user can update their own profile.
     * @deny (delete) - Users cannot delete their profiles.
     * @principle Enforces user-ownership for profile data and allows public read access for game purposes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return request.auth != null && request.auth.uid == userId && resource != null;
      }
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages incorrect problem attempts for a user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) - Only the authenticated user can create wrong answer records under their ID.
     * @allow (get, list) - Only the authenticated user can read their own wrong answer records.
     * @allow (update, delete) - Only the authenticated user can modify or delete their own wrong answer records.
     * @deny - Other users cannot access or modify this data.
     * @principle Restricts access to a user's own data tree, enforcing ownership.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
        function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
          return request.auth != null && request.auth.uid == userId && resource != null;
        }
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages country data.
     * @path /countries/{countryId}
     * @allow (get, list) - Any authenticated user can read country data.
     * @allow (create) - Any authenticated user can create a country. Requires 'createdBy' field matching auth.uid.
     * @allow (update) - Only the creator can update a country.
     * @deny (delete) - Countries cannot be deleted.
     * @principle Allows public read access, enforces ownership for writes.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(countryId) {
        return request.auth != null && request.resource.data.createdBy == request.auth.uid;
      }

      function isExistingOwner(countryId) {
          return request.auth != null && resource.data.createdBy == request.auth.uid;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isExistingOwner(countryId);
      allow delete: if false;
    }

    /**
     * @description Manages land tile data.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) - Any authenticated user can read land tile data.
     * @allow (create) - Any authenticated user can create land tiles; enforces ownerId matching auth.uid.
     * @allow (update) - Only the owner can update a land tile.
     * @deny (delete) - Land tiles cannot be deleted.
     * @principle Allows public read access, enforces ownership for writes.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(landTileId) {
        return request.auth != null && request.resource.data.ownerId == request.auth.uid;
      }

      function isExistingOwner(landTileId) {
          return request.auth != null && resource.data.ownerId == request.auth.uid;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(landTileId);
      allow delete: if false;
    }

    /**
     * @description Stores problem attempts for a user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) - Only the authenticated user can create problem attempts under their ID.
     * @allow (get, list) - Only the authenticated user can read their own problem attempts.
     * @deny (update, delete) - Problem attempts cannot be updated or deleted.
     * @principle Restricts access to a user's own data tree, enforcing ownership.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}