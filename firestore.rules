/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset prioritizes a user-centric security model with owner-only access to user profiles and their associated data.
 * Public read access is granted to certain collections (e.g., land_tiles) while restricting write access to authorized users.
 *
 * Data Structure:
 * - /users/{userId}: Stores personal user data, secured with owner-only access.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores user-specific wrong answers, secured with owner-only access.
 * - /countries/{countryId}: Stores country information, accessible to all users, with create/update restricted.
 * - /land_tiles/{landTileId}: Stores land tile data, publicly readable, with create/update restricted.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores user's problem attempts, secured with owner-only access.
 * - /join_requests/{requestId}: Stores requests from users to join a country.
 * - /alliance_requests/{requestId}: Stores requests from countries to form an alliance.
 *
 * Key Security Decisions:
 * - User listing is allowed via the /users collection.
 * - Public read access to land tiles enables game functionality.
 * - Write access to countries is restricted to prevent unauthorized modifications.
 *
 * Denormalization for Authorization:
 *   - The `LandTile` entity should include an `ownerId` field to simplify ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profiles based on ownership.
     * @path /users/{userId}
     * @allow (get, list): Signed-in user can read their own profile.
     * @allow (create): Signed-in user can create their profile if the user ID matches their auth ID.
     * @allow (update): Signed-in user can update their own profile.
     * @deny (create): Signed-in user cannot create a profile with a mismatched user ID.
     * @deny (delete): No user can delete a user profile.
     * @principle Enforces user-ownership for profile access and modification.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Manages wrong answer records for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (list, get): Only the owner can list/get their wrong answers.
     * @allow (create): Only the owner can create wrong answer records. userId in the path must match the userId in the resource data.
     * @allow (update): Only the owner can update wrong answer records, userId in the path must match the userId in the resource data.
     * @allow (delete): Only the owner can delete wrong answer records.
     * @deny: Any other operation is denied.
     * @principle Restricts access to user-owned data.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow list, get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages country records.
     * @path /countries/{countryId}
     * @allow (list, get): Any signed-in user can list/get countries.
     * @allow (create): Only signed-in users can create countries.
     * @allow (update): Only signed-in users can update countries.
     * @deny: Any other operation is denied.
     */
    match /countries/{countryId} {
      allow list, get: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages land tile records. Accessible to all authenticated users.
     * @path /land_tiles/{landTileId}
     * @allow (list, get): Any user can list/get land tiles.
     * @allow (create): Any signed-in user can create land tiles.
     * @allow (update): Any signed-in user can update land tiles.
     * @principle Allows open read access, restricts write access.
     */
    match /land_tiles/{landTileId} {
      allow list, get: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Stores problem attempts for users.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (list, get): Only the owner can list and get their attempts.
     * @allow (create): Only the owner can create attempts.
     * @principle Restricts access to user-owned data.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow list, get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if false;
    }

    /**
     * @description Manages join requests.
     * @path /join_requests/{requestId}
     * @allow (list, get): Any signed-in user can list/get join requests.
     * @allow (create): Any signed-in user can create join requests.
     * @allow (update): Any signed-in user can update join requests.
     */
    match /join_requests/{requestId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages alliance requests.
     * @path /alliance_requests/{requestId}
     * @allow (list, get): Any signed-in user can list/get alliance requests.
     * @allow (create): Any signed-in user can create alliance requests.
     * @allow (update): Any signed-in user can update alliance requests.
     */
    match /alliance_requests/{requestId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Provides metadata to the application.
     * @path /map_aggregates/latest
     * @allow (get): Anyone can read this document.
     * @deny (list, create, update, delete): No one can list, create, update, or delete this document.
     */
    match /map_aggregates/latest {
        allow get: if true;
        allow list, create, update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}