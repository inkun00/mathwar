/**
 * @fileoverview Firestore Security Rules for Decimal Conquest.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-specific data,
 * while allowing public read access to game-related data like land tiles and map events.
 * Users can only modify their own profiles and related data, while certain
 * collections like land tiles and map events are publicly readable.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Incorrect problem attempts, owned by the user.
 * - /countries/{countryId}: Country data, created and managed by users.
 * - /land_tiles/{landTileId}: Game board tiles, publicly readable, but writes are not allowed by the client.
 * - /problem_attempts/{userId}/attempts/{attemptId}: User's attempts at solving math problems.
 * - /join_requests/{requestId}: Requests from users to join a country.
 * - /alliance_requests/{requestId}: Requests from countries to form an alliance.
 * - /map_events/{eventId}: Map update events, publicly readable for real-time updates.
 *
 * Key Security Decisions:
 * - User listing is allowed.
 * - Land tiles and map events are publicly readable, but only the server can write to the `land_tiles` collection.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 * The `LandTile` entity contains denormalized data (ownerNickname, countryId, countryName, countryColor) to avoid costly `get()` calls when displaying the map.
 * This allows efficient read operations without compromising security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Users can read and update their own profile data.
     * @path /users/{userId}
     * @allow (get, list, create, update) User with ID 'user123' can read, create, and update /users/user123.
     * @deny (get, list, create, update) User with ID 'user456' cannot read or update /users/user123.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Manages user-specific wrong answers. Only the owning user can access this data.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (get, list, create, update, delete) User 'user123' can manage wrong answers under /users/user123/wrong_answers/.
     * @deny (get, list, create, update, delete) User 'user456' cannot access or modify /users/user123/wrong_answers/.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
       function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for countries. Anyone can read/list.
     * @path /countries/{countryId}
     * @allow (get, list) Any authenticated user can read a country's data.
     * @deny (create, update, delete) Only the server can create and update country data.
     * @principle Allows public reads, restricts writes.
     */
    match /countries/{countryId} {
        allow get: if true;
        allow list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Defines access rules for land tiles. Anyone can read.
     * @path /land_tiles/{landTileId}
     * @allow (get, list) Any authenticated user can read land tile data.
     * @deny (create, update, delete) Clients cannot modify land tile data directly.
     * @principle Allows public reads, restricts writes.
     */
    match /land_tiles/{landTileId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to problem attempts. Only the owning user can create/read this data.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (get, list, create) User 'user123' can create attempts under /problem_attempts/user123/attempts/.
     * @deny (get, list, create) User 'user456' cannot access or modify /problem_attempts/user123/attempts/.
     * @principle Restricts access to a user's own data tree.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
         function isOwner(userId) {
            return request.auth != null && request.auth.uid == userId;
          }

          function isExistingOwner(userId) {
              return isOwner(userId) && resource.data != null;
          }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for join requests.
     * @path /join_requests/{requestId}
     */
    match /join_requests/{requestId} {
        allow get: if true;
        allow list: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.requesterId;
        allow update: if false;
        allow delete: if false;
    }

     /**
      * @description Defines access rules for alliance requests.
      * @path /alliance_requests/{requestId}
      */
    match /alliance_requests/{requestId} {
        allow get: if true;
        allow list: if true;
        allow create: if request.auth != null; // TODO: Add country owner verification
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Defines access rules for map events. Publicly readable.
     * @path /map_events/{eventId}
     * @allow (list) Any authenticated user can list map events.
     * @allow (create) Server can create map events
     * @principle Allows public reads, restricts writes.
     */
    match /map_events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}