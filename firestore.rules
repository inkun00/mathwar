/**
 * @fileOverview Firestore Security Rules for the Decimal Conquest game.
 *
 * Core Philosophy:
 * This ruleset prioritizes user data protection, allowing only authenticated users to access most data,
 * with a strong emphasis on user-owned data. List operations are enabled selectively to support core
 * game functions while preventing unauthorized data discovery. The rules are structured to allow flexible data shapes
 * but strictly enforce authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the owning user.
 * - /users/{userId}/wrong_answers/{wrongAnswerId}: Stores wrong answers for a specific user. Only accessible by that user.
 * - /countries/{countryId}: Stores country data, created by users.
 * - /land_tiles/{landTileId}: Stores game board land tile data.
 * - /problem_attempts/{userId}/attempts/{attemptId}: Stores problem attempt data. Only the user can access their own attempts.
 *
 * Key Security Decisions:
 * - Users can only access their own user document.
 * - `list` is enabled on `/countries` and `/land_tiles` to support game functionality and discovery.
 * - `list` is enabled on `/users/{userId}/wrong_answers` and `/problem_attempts/{userId}/attempts/{attemptId}` to allow users to review their own incorrect problems.
 * - Data shape validation is relaxed to allow prototyping.
 *
 * Denormalization for Authorization:
 * - The `Country` entity requires a `createdBy` field to track ownership. Without this, secure write rules cannot be enforced.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles.
     * @path /users/{userId}
     * @allow (create) - User 'test_user' with UID 'test_user' can create their profile.
     * @deny (create) - User 'test_user' with UID 'other_user' cannot create a profile with ID 'test_user'.
     * @allow (get) - User 'test_user' can read their profile.
     * @deny (get) - User 'other_user' cannot read 'test_user' profile.
     * @principle Enforces user-ownership for data access.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Stores incorrect problems for a specific user.
     * @path /users/{userId}/wrong_answers/{wrongAnswerId}
     * @allow (create) - User 'test_user' can add a wrong answer to their profile.
     * @deny (create) - User 'other_user' cannot add a wrong answer to 'test_user' profile.
     * @allow (get) - User 'test_user' can read a wrong answer in their profile.
     * @deny (get) - User 'other_user' cannot read a wrong answer in 'test_user' profile.
     * @principle Enforces user-ownership for data access.
     */
    match /users/{userId}/wrong_answers/{wrongAnswerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
          return request.auth.uid == userId && resource != null;
        }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Stores country data. Accessible to all authenticated users.
     * @path /countries/{countryId}
     * @allow (create) - Any signed-in user can create a country.
     * @deny (create) - Non-signed-in user cannot create a country.
     * @allow (get) - Any signed-in user can get a country.
     * @deny (update) - Non-owner cannot update a country.
     * @principle Allows open reads, enforces owner-only writes.
     */
    match /countries/{countryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(countryId) {
          return request.resource.data.createdBy == request.auth.uid;
      }
      function isExistingOwner(countryId) {
          return resource.data.createdBy == request.auth.uid && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(countryId);
      allow delete: if false; // Countries should not be deletable by the user for now.
    }

    /**
     * @description Stores game board land tile data. Accessible to all authenticated users.
     * @path /land_tiles/{landTileId}
     * @allow (get) - Any signed-in user can read a land tile.
     * @allow (list) - Any signed-in user can list land tiles.
     * @deny (create) - Non-signed-in user cannot create a land tile.
     * @deny (update) - Non-owner cannot update a land tile.
     * @principle Allows open reads, enforces owner-only writes.
     */
    match /land_tiles/{landTileId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(landTileId) {
        return request.resource.data.ownerId == request.auth.uid;
      }
      function isExistingOwner(landTileId) {
          return resource.data.ownerId == request.auth.uid && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(landTileId);
      allow delete: if false; // Land tiles should not be deletable by the user for now.
    }

    /**
     * @description Stores problem attempt data for a user.
     * @path /problem_attempts/{userId}/attempts/{attemptId}
     * @allow (create) - User 'test_user' can add a problem attempt to their profile.
     * @deny (create) - User 'other_user' cannot add a problem attempt to 'test_user' profile.
     * @allow (get) - User 'test_user' can read a problem attempt in their profile.
     * @deny (get) - User 'other_user' cannot read a problem attempt in 'test_user' profile.
     *  @allow (list) - User 'test_user' can read a problem attempt in their profile.
     * @deny (list) - User 'other_user' cannot read a problem attempt in 'test_user' profile.
     * @principle Enforces user-ownership for data access.
     */
    match /problem_attempts/{userId}/attempts/{attemptId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }
  }
}