{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Decimal Conquest game.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the User entity." },
        "email": { "type": "string", "description": "User's email address.", "format": "email" },
        "nickname": { "type": "string", "description": "The user's display name." },
        "countryId": { "type": "string", "description": "Reference to the Country this user belongs to." },
        "tokens": { "type": "number", "description": "The number of expansion tokens the user has." },
        "conqueredCountries": { "type": "array", "description": "An array of country IDs that this user has conquered.", "items": { "type": "string" } },
        "gamePoints": { "type": "number", "description": "Points earned by the user for holding territory." },
        "lastPointDistribution": { "type": "string", "description": "The date (YYYY-MM-DD) when the last points were distributed." },
        "walls": { "type": "number", "description": "The number of wall items the user possesses." },
        "isCountryOwner": { "type": "boolean", "description": "Whether the user is the owner of their country." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the user was created." }
      },
      "required": ["id", "email", "nickname"]
    },
    "Country": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Country",
      "type": "object",
      "description": "Represents a country created by a user.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Country entity." },
        "name": { "type": "string", "description": "The name of the country." },
        "createdBy": { "type": "string", "description": "The UID of the user who created the country." },
        "color": { "type": "string", "description": "The HEX or HSL color string for the country." },
        "demised": { "type": "boolean", "description": "Whether the country has been conquered and can no longer be used." },
        "flag": { "type": "array", "description": "A 10x10 grid of colors for the country's flag.", "items": { "type": "string" } }
      },
      "required": ["id", "name", "createdBy", "color"]
    },
    "LandTile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LandTile",
      "type": "object",
      "description": "Represents a single land tile on the game map.",
      "properties": {
        "x": { "type": "number", "description": "X-coordinate of the land tile on the map." },
        "y": { "type": "number", "description": "Y-coordinate of the land tile on the map." },
        "ownerId": { "type": "string", "description": "Reference to the User who owns this land tile." },
        "hasWall": { "type": "boolean", "description": "Indicates if a defensive wall is built on this tile." }
      },
      "required": ["x", "y"]
    },
    "ProblemAttempt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProblemAttempt",
      "type": "object",
      "description": "Represents a user's attempt at solving a math problem.",
      "properties": {
        "id": { "type": "string" }, "userId": { "type": "string" },
        "unit": { "type": "string", "enum": ["decimal", "fraction"] },
        "area": { "type": "string" }, "correct": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isReview": { "type": "boolean" }, "problem": { "type": "string" }
      },
      "required": ["userId", "unit", "area", "correct", "timestamp", "isReview", "problem"]
    },
    "WrongAnswer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WrongAnswer",
      "type": "object",
      "description": "Stores problems that a user answered incorrectly.",
      "properties": {
        "id": { "type": "string" }, "userId": { "type": "string" },
        "problemData": { "type": "object" }, "problemString": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "problemData", "problemString", "createdAt"]
    },
    "JoinRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "JoinRequest",
        "type": "object",
        "description": "A user's request to join a country.",
        "properties": {
            "requesterId": { "type": "string" },
            "requesterNickname": { "type": "string" },
            "targetCountryId": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["requesterId", "requesterNickname", "targetCountryId", "status", "createdAt"]
    },
    "AllianceRequest": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "AllianceRequest",
        "type": "object",
        "description": "A country's request to form an alliance with another.",
        "properties": {
            "requestingCountryId": { "type": "string" },
            "requestingCountryName": { "type": "string" },
            "targetCountryId": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["requestingCountryId", "requestingCountryName", "targetCountryId", "status", "createdAt"]
    },
    "MapEvent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MapEvent",
      "type": "object",
      "description": "Represents a single change event on the game map. These events are used to broadcast delta updates to clients. TTL should be enabled on this collection.",
      "properties": {
        "tileId": { "type": "string", "description": "The document ID of the land_tile that was changed." },
        "x": { "type": "number", "description": "The x-coordinate of the tile." },
        "y": { "type": "number", "description": "The y-coordinate of the tile." },
        "newOwnerId": { "type": "string", "description": "The new owner's user ID. Null if it became unowned." },
        "newHasWall": { "type": "boolean", "description": "The new wall status of the tile." },
        "timestamp": { "type": "string", "format": "date-time", "description": "The timestamp of the event." }
      },
      "required": ["tileId", "x", "y", "newOwnerId", "newHasWall", "timestamp"]
    }
  },
  "auth": { "providers": ["password"] },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "user", "schema": { "$ref": "#/backend/entities/User" }, "description": "Stores user profiles.", "allow": ["get", "list", "create", "update"] }
      },
      {
        "path": "/users/{userId}/wrong_answers/{wrongAnswerId}",
        "definition": { "entityName": "wrongAnswer", "schema": { "$ref": "#/backend/entities/WrongAnswer" }, "description": "Stores incorrect problems for a user.", "allow": ["list", "get", "create", "update", "delete"] }
      },
      {
        "path": "/countries/{countryId}",
        "definition": { "entityName": "country", "schema": { "$ref": "#/backend/entities/Country" }, "description": "Stores all countries.", "allow": ["list", "get", "create", "update"] }
      },
       {
        "path": "/land_tiles/{landTileId}",
        "definition": {
          "entityName": "landTile",
          "schema": {
            "$ref": "#/backend/entities/LandTile"
          },
          "description": "Stores all land tiles on the game map. Accessible to all authenticated users for gameplay.",
           "allow": ["list", "get", "create", "update"]
        }
      },
      {
        "path": "/problem_attempts/{userId}/attempts/{attemptId}",
        "definition": { "entityName": "problemAttempt", "schema": { "$ref": "#/backend/entities/ProblemAttempt" }, "description": "Stores user problem attempts.", "allow": ["list", "get", "create"] }
      },
      {
          "path": "/join_requests/{requestId}",
          "definition": { "entityName": "joinRequest", "schema": { "$ref": "#/backend/entities/JoinRequest" }, "description": "Requests from users to join a country.", "allow": ["list", "get", "create", "update"] }
      },
      {
          "path": "/alliance_requests/{requestId}",
          "definition": { "entityName": "allianceRequest", "schema": { "$ref": "#/backend/entities/AllianceRequest" }, "description": "Requests from countries to form an alliance.", "allow": ["list", "get", "create", "update"] }
      },
      {
        "path": "/map_events/{eventId}",
        "definition": { "entityName": "mapEvent", "schema": { "$ref": "#/backend/entities/MapEvent" }, "description": "A collection of transient map change events for delta updates. Enable TTL.", "allow": ["list", "create"] }
      }
    ]
  }
}
